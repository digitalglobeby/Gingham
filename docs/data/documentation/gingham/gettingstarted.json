source","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Supplies the rows and values. Setting it reloads the table. Held weakly:"},{"type":"text","text":" "},{"type":"text","text":"keep the data source alive yourself."}],"title":"dataSource","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/dataSource"},"doc://ngtable.Gingham/documentation/Gingham/Licensing":{"abstract":[{"type":"text","text":"Free up to 10,000 rows a table; a license key shows every row."}],"kind":"article","url":"\/documentation\/gingham\/licensing","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Licensing","type":"topic","title":"Licensing","role":"collectionGroup"}}}