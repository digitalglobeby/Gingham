gettingstarted"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/MigratingFromNSTableView","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/UsingSwiftUI","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Licensing","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/ReleaseNotes","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDataSource","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate"],"anchor":"Essentials","title":"Essentials","generated":true}],"references":{"doc://ngtable.Gingham/documentation/Gingham/GHColumnVisibility/State":{"type":"topic","navigatorTitle":[{"text":"State","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"State","kind":"identifier"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnVisibility\/State","kind":"symbol","role":"symbol","url":"\/documentation\/gingham\/ghcolumnvisibility\/state","title":"GHColumnVisibility.State","abstract":[{"type":"text","text":"Checkmark state of a menu entry."}]},"doc://ngtable.Gingham/documentation/Gingham/GHNamedColor":{"role":"symbol","title":"GHNamedColor","url":"\/documentation\/gingham\/ghnamedcolor","type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHNamedColor","abstract":[{"text":"Colors of tags and marks, named like the system colors they are drawn","type":"text"},{"type":"text","text":" "},{"type":"text","text":"with, so the model stays independent of AppKit and UIKit."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GHNamedColor"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHNamedColor"}]},"doc://ngtable.Gingham/documentation/Gingham/MigratingFromNSTableView":{"identif