{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gingham\/gettingstarted"]}],"sections":[],"identifier":{"url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GettingStarted","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/ngtable.Gingham\/documentation\/Gingham"]]},"abstract":[{"text":"Add the package, show a table and fill it with data.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A table needs three things: a column definition, a data source that answers"},{"text":" ","type":"text"},{"type":"text","text":"how many rows there are and what each cell’s value is, and a place in a view"},{"type":"text","text":" "},{"type":"text","text":"hierarchy. Everything else is optional."}],"type":"paragraph"},{"level":3,"anchor":"Add-the-package","type":"heading","text":"Add the package"},{"inlineContent":[{"text":"Gingham is a Swift package for macOS 14 on Apple silicon and iOS and iPadOS 17 and later","type":"text"},{"text":" ","type":"text"},{"text":"(Intel Macs aren’t supported).","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"In Xcode:","type":"text"}],"type":"strong"},{"text":" choose File > Add Package Dependencies, click Add Local to pick","type":"text"},{"text":" ","type":"text"},{"text":"the package folder (or enter its Git URL), and add the ","type":"text"},{"code":"Gingham","type":"codeVoice"},{"text":" library to","type":"text"},{"text":" ","type":"text"},{"text":"your app target.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"In a ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}],"type":"strong"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/digitalglobeby\/Gingham\", from: \"1.8.0\"),  \/\/ or .package(path: \"..\/Gingham\")","],","targets: [","    .target(name: \"MyApp\", dependencies: [\"Gingham\"]),","]"]},{"inlineContent":[{"text":"Then ","type":"text"},{"code":"import Gingham","type":"codeVoice"},{"text":" where you use it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A minor version may add cases to the enums that describe values, formats,","type":"text"},{"text":" ","type":"text"},{"text":"filters and summaries (","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFormat","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnFilter","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCellValue","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","type":"reference","isActive":true},{"text":" and the like): keep a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" in a","type":"text"},{"text":" ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over them, and updates won’t stop your code from compiling.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"Linked as the binary ","type":"text"},{"type":"codeVoice","code":"Gingham.xcframework"},{"text":", Gingham’s enums may get","type":"text"},{"text":" ","type":"text"},{"text":"new cases in later versions, so a ","type":"text"},{"type":"codeVoice","code":"switch"},{"text":" over one needs ","type":"text"},{"type":"codeVoice","code":"@unknown default"},{"text":" ","type":"text"},{"text":"(an error in Swift 6 without it). ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnItem","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHDataColumnItem","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnPin","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnVisibility\/State","type":"reference"},{"text":" are frozen: their cases are","type":"text"},{"text":" ","type":"text"},{"text":"all there will be. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCellValue","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHNamedColor","type":"reference"},{"text":" are frozen too, so","type":"text"},{"text":" ","type":"text"},{"text":"an app makes values as fast as Gingham does, but a minor version may still","type":"text"},{"text":" ","type":"text"},{"text":"add cases to them: keep a ","type":"text"},{"type":"codeVoice","code":"default"},{"text":" in a ","type":"text"},{"type":"codeVoice","code":"switch"},{"text":" over them.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note"},{"text":"Define the columns","anchor":"Define-the-columns","type":"heading","level":3},{"inlineContent":[{"text":"Columns are values of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableColumn","type":"reference"},{"text":", listed as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnItem","type":"reference"},{"text":"s. Each","type":"text"},{"text":" ","type":"text"},{"text":"column has an ","type":"text"},{"type":"codeVoice","code":"id"},{"text":", which is also the key the data source answers values for:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let columns: [GHColumnItem] = [","    .column(GHTableColumn(\"name\", title: \"Campaign\", width: 220, pin: .leading)),","    .column(GHTableColumn(\"status\", title: \"Status\", width: 120)),","    .column(GHTableColumn(\"spend\", title: \"Spend\", width: 120,","                          alignment: .automatic, format: .currency(code: \"EUR\"),","                          summary: .aggregate(.sum))),","    .column(GHTableColumn(\"clicks\", title: \"Clicks\", width: 100,","                          alignment: .automatic, format: .number(fractionDigits: 0),","                          summary: .aggregate(.sum))),","]"]},{"inlineContent":[{"type":"codeVoice","code":"pin: .leading"},{"text":" freezes the name column at the leading edge; ","type":"text"},{"type":"codeVoice","code":"alignment: .automatic"},{"text":" aligns numbers to the trailing edge. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/DefiningColumns","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Provide-the-data","type":"heading","text":"Provide the data"},{"inlineContent":[{"text":"The data source is any class that adopts ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDataSource","type":"reference"},{"text":". Keep your","type":"text"},{"text":" ","type":"text"},{"text":"records in an array and answer from it:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Campaign {","    var id: String","    var name: String","    var status: String","    var spend: Double","    var clicks: Int","}","","@MainActor","final class CampaignTableData: GHTableViewDataSource {","    var campaigns: [Campaign] = []","","    func numberOfRows(in tableView: GHTableView) -> Int {","        campaigns.count","    }","","    func tableView(_ tableView: GHTableView, valueFor column: GHTableColumn, row: Int) -> GHCellValue {","        let campaign = campaigns[row]","        switch column.id {","        case \"id\": return .text(campaign.id)","        case \"name\": return .text(campaign.name)","        case \"status\": return .text(campaign.status)","        case \"spend\": return .number(campaign.spend)","        case \"clicks\": return .number(Double(campaign.clicks))","        default: return .empty","        }","    }","}"]},{"inlineContent":[{"text":"Return ","type":"text"},{"type":"codeVoice","code":".empty"},{"text":" for columns you don’t know: the table may ask about columns","type":"text"},{"text":" ","type":"text"},{"text":"that aren’t shown, such as the inputs of a summary formula.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Show-the-table","type":"heading","text":"Show the table"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView","type":"reference"},{"text":" is an ","type":"text"},{"code":"NSView","type":"codeVoice"},{"text":" that scrolls by itself. Add it directly to your","type":"text"},{"text":" ","type":"text"},{"text":"view (not inside an ","type":"text"},{"code":"NSScrollView","type":"codeVoice"},{"text":") and pin it with Auto Layout:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["final class CampaignsViewController: NSViewController, GHTableViewDelegate {","    private let data = CampaignTableData()","    private let table = GHTableView(frame: .zero)","","    override func loadView() {","        let root = NSView()","        table.columns = columns","        table.rowIdentifierColumnID = \"id\"          \/\/ Keeps the selection on the same campaigns.","        table.autosaveName = \"CampaignsTable\"       \/\/ Remembers the user's columns.","        table.emptyStateText = \"No campaigns\"","        table.dataSource = data","        table.delegate = self","        table.translatesAutoresizingMaskIntoConstraints = false","        root.addSubview(table)","        NSLayoutConstraint.activate([","            table.topAnchor.constraint(equalTo: root.topAnchor),","            table.leadingAnchor.constraint(equalTo: root.leadingAnchor),","            table.trailingAnchor.constraint(equalTo: root.trailingAnchor),","            table.bottomAnchor.constraint(equalTo: root.bottomAnchor),","        ])","        view = root","    }","}"]},{"inlineContent":[{"text":"The table holds its data source and delegate weakly: keep them alive, as the","type":"text"},{"text":" ","type":"text"},{"text":"view controller above does with ","type":"text"},{"code":"data","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Update-the-data","text":"Update the data","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Whenever the records change, change them and call"},{"type":"text","text":" "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadData()","type":"reference","isActive":true},{"type":"text","text":" right away:"}]},{"syntax":"swift","type":"codeListing","code":["func show(_ campaigns: [Campaign]) {","    data.campaigns = campaigns","    table.reloadData()","}"]},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"text":"Call ","type":"text"},{"code":"reloadData()","type":"codeVoice"},{"text":" immediately after replacing the data, before","type":"text"},{"text":" ","type":"text"},{"text":"selecting rows, scrolling or returning to the run loop. Until then the table","type":"text"},{"text":" ","type":"text"},{"text":"still asks about the old rows, which may no longer exist, and an index out","type":"text"},{"text":" ","type":"text"},{"text":"of range would crash your data source.","type":"text"}],"type":"paragraph"}]},{"inlineContent":[{"text":"Setting ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/dataSource"},{"text":" also reloads the table.","type":"text"}],"type":"paragraph"},{"text":"Try the demo","level":3,"type":"heading","anchor":"Try-the-demo"},{"inlineContent":[{"type":"text","text":"The package contains a demo app with ad campaign data. Open the package in"},{"type":"text","text":" "},{"type":"text","text":"Xcode, choose the "},{"type":"codeVoice","code":"GinghamDemo"},{"text":" scheme and run it (Command-R). It shows frozen","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and grouped columns, marks, a ROI formula, search, a filter checkbox, summary"},{"type":"text","text":" "},{"type":"text","text":"scopes, row tints, a context menu and row counts up to 100,000. Its source,"},{"type":"text","text":" "},{"code":"Sources\/GinghamDemo\/GinghamDemo.swift","type":"codeVoice"},{"type":"text","text":", is a complete example."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Next Steps","anchor":"Next-Steps"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp","type":"reference","isActive":true},{"text":" walks through a complete setup for records from","type":"text"},{"text":" ","type":"text"},{"text":"a server: identities, sorting, search, filters, menus and refreshing.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/DefiningColumns"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/DisplayingValues"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Summaries"},{"text":" describe","type":"text"},{"text":" ","type":"text"},{"text":"the column options.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"role":"article","modules":[{"name":"Gingham"}],"roleHeading":"Article","title":"Getting Started"