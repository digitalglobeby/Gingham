{"identifier":{"url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GettingStarted","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A table needs three things: a column definition, a data source that answers"},{"type":"text","text":" "},{"type":"text","text":"how many rows there are and what each cell’s value is, and a place in a view"},{"type":"text","text":" "},{"type":"text","text":"hierarchy. Everything else is optional."}]},{"type":"heading","level":3,"anchor":"Add-the-package","text":"Add the package"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Gingham is a Swift package for macOS 14 on Apple silicon and iOS and iPadOS 17 and later"},{"type":"text","text":" "},{"type":"text","text":"(Intel Macs aren’t supported)."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"In Xcode:"}]},{"type":"text","text":" choose File > Add Package Dependencies, click Add Local to pick"},{"type":"text","text":" "},{"type":"text","text":"the package folder (or enter its Git URL), and add the "},{"type":"codeVoice","code":"Gingham"},{"type":"text","text":" library to"},{"type":"text","text":" "},{"type":"text","text":"your app target."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"In a "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]}]}]}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/digitalglobeby\/Gingham\", from: \"1.8.0\"),  \/\/ or .package(path: \"..\/Gingham\")","],","targets: [","    .target(name: \"MyApp\", dependencies: [\"Gingham\"]),","]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then "},{"type":"codeVoice","code":"import Gingham"},{"type":"text","text":" where you use it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A minor version may add cases to the enums that describe values, formats,"},{"type":"text","text":" "},{"type":"text","text":"filters and summaries ("},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFormat","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnFilter","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCellValue","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","isActive":true,"type":"reference"},{"type":"text","text":" and the like): keep a "},{"type":"codeVoice","code":"default"},{"type":"text","text":" in a"},{"type":"text","text":" "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" over them, and updates won’t stop your code from compiling."}]},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Linked as the binary ","type":"text"},{"code":"Gingham.xcframework","type":"codeVoice"},{"text":", Gingham’s enums may get","type":"text"},{"text":" ","type":"text"},{"text":"new cases in later versions, so a ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over one needs ","type":"text"},{"code":"@unknown default","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(an error in Swift 6 without it). ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnItem"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHDataColumnItem"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnPin"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnVisibility\/State"},{"text":" are frozen: their cases are","type":"text"},{"text":" ","type":"text"},{"text":"all there will be. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCellValue"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHNamedColor"},{"text":" are frozen too, so","type":"text"},{"text":" ","type":"text"},{"text":"an app makes values as fast as Gingham does, but a minor version may still","type":"text"},{"text":" ","type":"text"},{"text":"add cases to them: keep a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over them.","type":"text"}]}],"style":"note"},{"type":"heading","level":3,"anchor":"Define-the-columns","text":"Define the columns"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Columns are values of "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableColumn","isActive":true,"type":"reference"},{"type":"text","text":", listed as "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnItem","isActive":true,"type":"reference"},{"type":"text","text":"s. Each"},{"type":"text","text":" "},{"type":"text","text":"column has an "},{"type":"codeVoice","code":"id"},{"type":"text","text":", which is also the key the data source answers values for:"}]},{"type":"codeListing","syntax":"swift","code":["let columns: [GHColumnItem] = [","    .column(GHTableColumn(\"name\", title: \"Campaign\", width: 220, pin: .leading)),","    .column(GHTableColumn(\"status\", title: \"Status\", width: 120)),","    .column(GHTableColumn(\"spend\", title: \"Spend\", width: 120,","                          alignment: .automatic, format: .currency(code: \"EUR\"),","                          summary: .aggregate(.sum))),","    .column(GHTableColumn(\"clicks\", title: \"Clicks\", width: 100,","                          alignment: .automatic, format: .number(fractionDigits: 0),","                          summary: .aggregate(.sum))),","]"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pin: .leading"},{"type":"text","text":" freezes the name column at the leading edge; "},{"type":"codeVoice","code":"alignment: .automatic"},{"type":"text","text":" aligns numbers to the trailing edge. See "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/DefiningColumns","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"Provide-the-data","text":"Provide the data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The data source is any class that adopts "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDataSource","isActive":true,"type":"reference"},{"type":"text","text":". Keep your"},{"type":"text","text":" "},{"type":"text","text":"records in an array and answer from it:"}]},{"type":"codeListing","syntax":"swift","code":["struct Campaign {","    var id: String","    var name: String","    var status: String","    var spend: Double","    var clicks: Int","}","","@MainActor","final class CampaignTableData: GHTableViewDataSource {","    var campaigns: [Campaign] = []","","    func numberOfRows(in tableView: GHTableView) -> Int {","        campaigns.count","    }","","    func tableView(_ tableView: GHTableView, valueFor column: GHTableColumn, row: Int) -> GHCellValue {","        let campaign = campaigns[row]","        switch column.id {","        case \"id\": return .text(campaign.id)","        case \"name\": return .text(campaign.name)","        case \"status\": return .text(campaign.status)","        case \"spend\": return .number(campaign.spend)","        case \"clicks\": return .number(Double(campaign.clicks))","        default: return .empty","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"type":"codeVoice","code":".empty"},{"type":"text","text":" for columns you don’t know: the table may ask about columns"},{"type":"text","text":" "},{"type":"text","text":"that aren’t shown, such as the inputs of a summary formula."}]},{"type":"heading","level":3,"anchor":"Show-the-table","text":"Show the table"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView","isActive":true,"type":"reference"},{"type":"text","text":" is an "},{"type":"codeVoice","code":"NSView"},{"type":"text","text":" that scrolls by itself. Add it directly to your"},{"type":"text","text":" "},{"type":"text","text":"view (not inside an "},{"type":"codeVoice","code":"NSScrollView"},{"type":"text","text":") and pin it with Auto Layout:"}]},{"type":"codeListing","syntax":"swift","code":["final class CampaignsViewController: NSViewController, GHTableViewDelegate {","    private let data = CampaignTableData()","    private let table = GHTableView(frame: .zero)","","    override func loadView() {","        let root = NSView()","        table.columns = columns","        table.rowIdentifierColumnID = \"id\"          \/\/ Keeps the selection on the same campaigns.","        table.autosaveName = \"CampaignsTable\"       \/\/ Remembers the user's columns.","        table.emptyStateText = \"No campaigns\"","        table.dataSource = data","        table.delegate = self","        table.translatesAutoresizingMaskIntoConstraints = false","        root.addSubview(table)","        NSLayoutConstraint.activate([","            table.topAnchor.constraint(equalTo: root.topAnchor),","            table.leadingAnchor.constraint(equalTo: root.leadingAnchor),","            table.trailingAnchor.constraint(equalTo: root.trailingAnchor),","            table.bottomAnchor.constraint(equalTo: root.bottomAnchor),","        ])","        view = root","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The table holds its data source and delegate weakly: keep them alive, as the"},{"type":"text","text":" "},{"type":"text","text":"view controller above does with "},{"type":"codeVoice","code":"data"},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"Update-the-data","text":"Update the data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Whenever the records change, change them and call"},{"type":"text","text":" "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadData()","isActive":true,"type":"reference"},{"type":"text","text":" right away:"}]},{"type":"codeListing","syntax":"swift","code":["func show(_ campaigns: [Campaign]) {","    data.campaigns = campaigns","    table.reloadData()","}"]},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"reloadData()","type":"codeVoice"},{"text":" immediately after replacing the data, before","type":"text"},{"text":" ","type":"text"},{"text":"selecting rows, scrolling or returning to the run loop. Until then the table","type":"text"},{"text":" ","type":"text"},{"text":"still asks about the old rows, which may no longer exist, and an index out","type":"text"},{"text":" ","type":"text"},{"text":"of range would crash your data source.","type":"text"}]}],"style":"important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Setting "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/dataSource","isActive":true,"type":"reference"},{"type":"text","text":" also reloads the table."}]},{"type":"heading","level":3,"anchor":"Try-the-demo","text":"Try the demo"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package contains a demo app with ad campaign data. Open the package in"},{"type":"text","text":" "},{"type":"text","text":"Xcode, choose the "},{"type":"codeVoice","code":"GinghamDemo"},{"type":"text","text":" scheme and run it (Command-R). It shows frozen"},{"type":"text","text":" "},{"type":"text","text":"and grouped columns, marks, a ROI formula, search, a filter checkbox, summary"},{"type":"text","text":" "},{"type":"text","text":"scopes, row tints, a context menu and row counts up to 100,000. Its source,"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sources\/GinghamDemo\/GinghamDemo.swift"},{"type":"text","text":", is a complete example."}]},{"type":"heading","level":2,"anchor":"Next-Steps","text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp","type":"reference","isActive":true},{"type":"text","text":" walks through a complete setup for records from"},{"type":"text","text":" "},{"type":"text","text":"a server: identities, sorting, search, filters, menus and refreshing."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/DefiningColumns","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/DisplayingValues","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Summaries","type":"reference","isActive":true},{"type":"text","text":" describe"},{"type":"text","text":" "},{"type":"text","text":"the column options."}]}]}]}]}],"metadata":{"roleHeading":"Article","title":"Getting Started","modules":[{"name":"Gingham"}],"role":"article"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gingham\/gettingstarted"]}],"abstract":[{"type":"text","text":"Add the package, show a table and fill it with data."}],"seeAlsoS