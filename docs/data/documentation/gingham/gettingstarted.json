/GHColumnItem":{"abstract":[{"type":"text","text":"A top-level entry of the table’s column definition."}],"role":"symbol","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnItem","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"GHColumnItem","kind":"identifier"}],"url":"\/documentation\/gingham\/ghcolumnitem","title":"GHColumnItem","navigatorTitle":[{"text":"GHColumnItem","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/Licensing":{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Licensing","role":"collectionGroup","abstract":[{"type":"text","text":"Free up to 10,000 rows a table; a license key shows every row."}],"url":"\/documentation\/gingham\/licensing","kind":"article","title":"Licensing","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/UsingSwiftUI":{"abstract":[{"text":"Show rows in SwiftUI like with ","type":"text"},{"code":"Table","type":"codeVoice"},{"text":", with Gingham’s speed and features.","type":"text"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/UsingSwiftUI","title":"Using Gingham in SwiftUI","type":"topic","kind":"article","role":"collectionGroup","url":"\/documentation\/gingham\/usingswiftui"},"doc://ngtable.Gingham/documentation/Gingham/GHNamedColor":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHNamedColor","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHNamedColor"}],"navigatorTitle":[{"kind":"identifier","text":"GHNamedColor"}],"role":"symbol","kind":"symbol","url":"\/documentation\/gingham\/ghnamedcolor","title":"GHNamedColor","abstract":[{"text":"Colors of tags and marks, named like the system colors they are drawn","type":"text"},{"text":" ","type":"text"},{"text":"with, so the model stays independent of AppKit and UIKit.","type":"text"}]},"doc://ngtable.Gingham/documentation/Gingham/GHColumnPin":{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnPin","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHColumnPin"}],"url":"\/documentation\/gingham\/ghcolumnpin","role":"symbol","abstract":[{"type":"text","text":"Horizontal placement of a column or a column group."}],"navigatorTitle":[{"kind":"identifier","text":"GHColumnPin"}],"title":"GHColumnPin","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/GHColumnVisibility/State":{"type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"State","kind":"identifier"}],"title":"GHColumnVisibility.State","kind":"symbol","abstract":[{"type":"text","text":"Checkmark state of a menu entry."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnVisibility\/State","url":"\/documentation\/gingham\/ghcolumnvisibility\/state","navigatorTitle":[{"kind":"identifier","text":"State"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableViewDataSource":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GHTableViewDataSource","kind":"identifier"}],"abstract":[{"type":"text","text":"Supplies rows and cell values to an "},{"type":"codeVoice","code":"GHTableView"},{"type":"text","text":"."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDataSource","type":"topic","kind":"symbol","title":"GHTableViewDataSource","role":"symbol","navigatorTitle":[{"text":"GHTableViewDataSource","kind":"identifier"}],"url":"\/documentation\/gingham\/ghtableviewdatasource"},"doc://ngtable.Gingham/documentation/Gingham/GHValueFormat":{"navigatorTitle":[{"kind":"identifier","text":"GHValueFormat"}],"abstract":[{"type":"text","text":"How a column turns values into display strings."}],"kind":"symbol","url":"\/documentation\/gingham\/ghvalueformat","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHValueFormat"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFormat","role":"symbol","title":"GHValueFormat","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/reloadData()":{"role":"symbol","abstract":[{"type":"text","text":"Reads the data again: the number of rows, the visible cells, the"},{"type":"text","text":" "},{"type":"text","text":"summaries, the filter and the search index."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reloadData"},{"kind":"text","text":"()"}],"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadData()","title":"reloadData()","url":"\/documentation\/gingham\/ghtableview\/reloaddata()","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham","role":"collection","kind":"symbol","url":"\/documentation\/gingham","title":"Gingham","abstract":[{"type":"text","text":"A fast table for business data on the Mac, iPad and iPhone: frozen columns,"},{"type":"text","text":" "},{"type":"text","text":"column groups, a summary row with formulas, row grouping with subtotals, search and filters, stable"},{"type":"text","text":" "},{"type":"text","text":"selection across reloads, and live updates."}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableViewDelegate":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHTableViewDelegate"}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GHTableViewDelegate"}],"url":"\/documentation\/gingham\/ghtableviewdelegate","title":"GHTableViewDelegate","abstract":[{"text":"Optional customization and notifications of an ","type":"text"},{"code":"GHTableView","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableVie