{"variants":[{"paths":["\/documentation\/gingham\/releasenotes"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/ReleaseNotes","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"Gingham follows semantic versioning: a new major version for changes that","type":"text"},{"text":" ","type":"text"},{"text":"break the API. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/version","type":"reference"},{"text":" is the version an app links; a","type":"text"},{"text":" ","type":"text"},{"text":"license key is for a major version (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Licensing","type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"text":"1.0.1","level":2,"type":"heading","anchor":"101"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Faster with an app’s own data."}],"type":"strong"},{"type":"text","text":" The table reads an app’s values"},{"type":"text","text":" "},{"type":"text","text":"faster for export, copy, column widths and scrolling: export of 200,000"},{"type":"text","text":" "},{"type":"text","text":"rows of 12 columns is 20% faster."},{"type":"text","text":" "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCellValue","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHNamedColor","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTag","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableColumn","type":"reference","isActive":true},{"type":"text","text":" are"},{"text":" ","type":"text"},{"text":"frozen. A minor version may still add cases to the enums: keep a","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"default"},{"text":" in a ","type":"text"},{"type":"codeVoice","code":"switch"},{"text":" over them.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Lighter live feeds.","type":"text"}],"type":"strong"},{"text":" On the Mac, a feed keeps the main thread a third","type":"text"},{"text":" ","type":"text"},{"text":"to two thirds less busy, and a quieter one shows new values 6–8 ms sooner.","type":"text"},{"text":" ","type":"text"},{"text":"Flashes of changed values take half the frames on 120 Hz displays.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Faster text sorts of an app’s own data","type":"text"}],"type":"strong"},{"text":", about 20% for 10 million rows.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Less memory for sorted and searched huge tables","type":"text"}],"type":"strong"},{"text":", about 10% less a row.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"1.0.0","level":2,"type":"heading","anchor":"100"},{"inlineContent":[{"text":"The first release as Gingham, a binary package for macOS 14, iOS and iPadOS","type":"text"},{"text":" ","type":"text"},{"text":"17 and later on Apple silicon. Gingham was NGTable (1.0 to 1.8): the engine","type":"text"},{"text":" ","type":"text"},{"text":"and its API are the same, renamed.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Free up to 10,000 rows a table","type":"text"}],"type":"strong"},{"text":", for any use, commercial too; a license","type":"text"},{"text":" ","type":"text"},{"text":"key (","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHLicense\/register(_:)","type":"reference"},{"text":") shows every row. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Licensing","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"One table view for AppKit and UIKit","type":"text"}],"type":"strong"},{"text":", drawn by the GPU: frozen columns","type":"text"},{"text":" ","type":"text"},{"text":"and column groups, a summary row with formulas, row grouping with","type":"text"},{"text":" ","type":"text"},{"text":"subtotals, filters and search, live updates, editing in place, and a","type":"text"},{"text":" ","type":"text"},{"text":"selection that follows records across reloads and sorts.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Millions of rows","type":"text"}],"type":"strong"},{"text":" through a column source (","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnSource","type":"reference"},{"text":"): sorting,","type":"text"},{"text":" ","type":"text"},{"text":"search, column filters, totals, copy and export run on all cores, off the","type":"text"},{"text":" ","type":"text"},{"text":"main thread.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Faster than 1.8.3","type":"text"}],"type":"strong"},{"text":" in number formatting, text layout, text sorts’ keys,","type":"text"},{"text":" ","type":"text"},{"text":"CSV and Excel export, and drawing cells that look alike.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Moving from NGTable","level":3,"type":"heading","anchor":"Moving-from-NGTable"},{"items":[{"content":[{"inlineContent":[{"text":"The module is ","type":"text"},{"code":"Gingham","type":"codeVoice"},{"text":" (and ","type":"text"},{"code":"GinghamICU","type":"codeVoice"},{"text":"): ","type":"text"},{"code":"import Gingham","type"