?","kind":"text"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/emptyStateView":{"url":"\/documentation\/gingham\/ghtableview\/emptystateview","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emptyStateView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GHPlatformView","preciseIdentifier":"s:7Gingham14GHPlatformViewa","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"text":"A custom view shown instead of ","type":"text"},{"code":"emptyStateText","type":"codeVoice"},{"text":" while there are no rows","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. with an image and a button). It is sized to its fitting size and","type":"text"},{"text":" ","type":"text"},{"text":"centered; use Auto Layout inside it.","type":"text"}],"type":"topic","title":"emptyStateView","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/emptyStateView","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/reloadData()":{"role":"symbol","title":"reloadData()","url":"\/documentation\/gingham\/ghtableview\/reloaddata()","type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadData()","abstract":[{"type":"text","text":"Reads the data again: the number of rows, the visible cells, the"},{"text":" ","type":"text"},{"text":"summaries, the filter and the search index.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"reloadData","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/didScrollNotification":{"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"didScrollNotification","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Notification","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation12NotificationV"},{"text":".","kind":"text"},{"text":"Name","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation12NotificationV4Namea"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/didScrollNotification","kind":"symbol","role":"symbol","url":"\/documentation\/gingham\/ghtableview\/didscrollnotification","title":"didScrollNotification","abstract":[{"text":"Posted after the scroll position (","type":"text"},{"code":"contentOffset","type":"codeVoice"},{"text":") changed, by the","type":"text"},{"text":" ","type":"text"},{"text":"user or in code, with the rows laid out there: what apps observe a","type":"text"},{"text":" ","type":"text"},{"text":"clip view’s ","type":"text"},{"code":"boundsDidChangeNotification","type":"codeVoice"},{"text":" for with NSTableView (e.g.","type":"text"},{"text":" ","type":"text"},{"text":"to load the next page when ","type":"text"},{"code":"rowIndexes(in: bounds)","type":"codeVoice"},{"text":" reaches the end).","type":"text"},{"text":" ","type":"text"},{"text":"Not posted for the rubber band past the edges. The object is the table.","type":"text"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/usesAlternatingRowBackgroundColors":{"url":"\/documentation\/gingham\/ghtableview\/usesalternatingrowbackgroundcolors","abstract":[{"type":"text","text":"Whether rows alternate between the system’s two content background"},{"type":"text","text":" "},{"type":"text","text":"colors. Row tints from the delegate replace the stripes of their rows."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/usesAlternatingRowBackgroundColors","title":"usesAlternatingRowBackgroundColors","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"usesAlternatingRowBackgroundColors"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol"},"doc://ngtable.Gingham/