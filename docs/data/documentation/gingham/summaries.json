{"metadata":{"title":"Summaries","modules":[{"name":"Gingham"}],"roleHeading":"Article","role":"article"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The summary row at the bottom of the table shows one value per column, aligned"},{"type":"text","text":" "},{"type":"text","text":"with the column. What a column shows is its "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnSummary","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["GHTableColumn(\"spend\", title: \"Spend\", format: .currency(code: \"EUR\"), summary: .aggregate(.sum))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The summary row holds values only, no captions; use the column’s "},{"type":"codeVoice","code":"toolTip"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"explain a less obvious one (“Average of campaigns that ran”). Values are"},{"type":"text","text":" "},{"type":"text","text":"formatted with the column’s format, except counts, which are whole numbers."},{"type":"text","text":" "},{"type":"text","text":"Hide the row with "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryRow","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only "},{"type":"codeVoice","code":".number"},{"type":"text","text":" values take part, and dates: a column of dates counts them,"},{"type":"text","text":" "},{"type":"text","text":"and its minimum, maximum and average are dates (the earliest, the latest),"},{"type":"text","text":" "},{"type":"text","text":"shown in the column’s date format. Empty values, text, NaN and infinity are"},{"type":"text","text":" "},{"type":"text","text":"left out, so a column where some rows have no value summarizes the others."}],"type":"paragraph"},{"text":"Aggregates","anchor":"Aggregates","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":".aggregate(_:including:)"},{"type":"text","text":" computes an "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","type":"reference"},{"type":"text","text":" of the column’s own"},{"type":"text","text":" "},{"type":"text","text":"values:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Aggregate"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Result"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Without values"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sum"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The total, summed without rounding drift"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Blank"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".average"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The mean"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Blank"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".count"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"How many rows have a number"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"0"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".min"},{"type":"text","text":", "},{"type":"codeVoice","code":".max"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The smallest or largest value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Blank"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFilter","type":"reference"},{"type":"text","text":" limits the values: "},{"type":"codeVoice","code":".nonZero"},{"type":"text","text":", "},{"type":"codeVoice","code":".positive"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":".nonNegative"},{"type":"text","text":", or your own:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ The average ROI of the campaigns that actually ran.","summary: .aggregate(.average, including: .nonZero)","","\/\/ A custom filter: give it a unique name.","let large = GHValueFilter(\"atLeast1000\") { $0 >= 1000 }","summary: .aggregate(.count, including: large)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Filters may be called off the main thread, so they must only look at the"},{"type":"text","text":" "},{"type":"text","text":"value."}],"type":"paragraph"},{"text":"Formulas","anchor":"Formulas","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Many business totals are not an aggregate of the column’s own values. The"},{"type":"text","text":" "},{"type":"text","text":"total ROI of several campaigns is not the average of their ROIs: a small"},{"type":"text","text":" "},{"type":"text","text":"campaign with +200 % would outweigh a big one with −10 %. It is the ratio of"},{"type":"text","text":" "},{"type":"text","text":"the sums: (Σ revenue − Σ spend) \/ Σ spend. An "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryFormula","type":"reference"},{"type":"text","text":" computes"},{"type":"text","text":" "},{"type":"text","text":"such values from aggregates of other columns:"}],"type":"paragraph"},{"syntax":"swift","code":["static let roi = GHSummaryFormula(\"roi\", using: [\"spend\", \"revenue\"],","                                  otherwise: .average, including: .nonZero) { values in","    guard let spend = values.sum(\"spend\"), spend != 0,","          let revenue = values.sum(\"revenue\") else { return nil }","    return (revenue - spend) \/ spend","}","","GHTableColumn(\"roi\", title: \"ROI\", format: .percent(fractionDigits: 1), summary: .formula(roi))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Other examples:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Metric"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Formula"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"CTR"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Σ clicks \/ Σ impressions"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPC"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Σ spend \/ Σ clicks"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPA"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Σ spend \/ Σ conversions"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conversion rate"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Σ conversions \/ Σ clicks"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Margin"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"(Σ revenue − Σ cost) \/ Σ revenue"}]}]]],"type":"table"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"inputs","type":"codeVoice"},{"text":" lists every column the formula reads. They don’t need to be shown,","type":"text"},{"text":" ","type":"text"},{"text":"or even defined: the data source is asked for their values by id like for any","type":"text"},{"text":" ","type":"text"},{"text":"column, so a formula can use raw numbers the table doesn’t display.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryValues"},{"text":" gives each input’s sum, average, count, min and max in the","type":"text"},{"text":" ","type":"text"},{"text":"current scope; ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the input has no numbers there.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the value can’t be computed, for example when dividing by","type":"text"},{"text":" ","type":"text"},{"text":"zero. The table then shows the ","type":"text"},{"code":"otherwise","type":"codeVoice"},{"text":" aggregate of the column’s own","type":"text"},{"text":" ","type":"text"},{"text":"values (filtered by ","type":"text"},{"code":"including","type":"codeVoice"},{"text":"), or nothing.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Formulas are compared by name: give every different formula its own name,","type":"text"},{"text":" ","type":"text"},{"text":"and keep it a pure function of its inputs (it may run off the main thread).","type":"text"}]}]}],"type":"unorderedList"},{"text":"Scopes","anchor":"Scopes","level":3,"type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryScope","type":"reference"},{"type":"text","text":" chooses the rows the summaries cover"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryScope","type":"reference"},{"type":"text","text":"):"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".allRows","type":"codeVoice"},{"text":": every row shown (after the filter);","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".selectedRows","type":"codeVoice"},{"text":": the selected rows;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".excludingSelectedRows","type":"codeVoice"},{"text":": every row shown except the selected ones, for","type":"text"},{"text":" ","type":"text"},{"text":"“what if we stopped these campaigns?”.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Users change the scope from the summary row’s context menu; the table reports"},{"type":"text","text":" "},{"type":"text","text":"it with "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:summaryScopeDidChange:)","type":"reference"},{"type":"text","text":", so you can"},{"type":"text","text":" "},{"type":"text","text":"update your own controls. The menu titles are localized in English and"},{"type":"text","text":" "},{"type":"text","text":"Russian; change them with "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryScopeTitles","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Summaries always cover the rows the filter shows, never rows it hides."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/rowGrouping","type":"reference"},{"type":"text","text":", every group header shows subtotals with"},{"type":"text","text":" "},{"type":"text","text":"the same aggregates and formulas over the group’s rows (see"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GroupingRows","type":"reference"},{"type":"text","text":"); the summary row keeps covering all rows of its scope."}],"type":"paragraph"},{"text":"Reading summary values","anchor":"Reading-summary-values","level":3,"type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryValue(forColumnID:)","type":"reference"},{"type":"text","text":" returns the value of a column in the"},{"type":"text","text":" "},{"type":"text","text":"current scope, and "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryText(forColumnID:)","type":"reference"},{"type":"text","text":" the text as"},{"type":"text","text":" "},{"type":"text","text":"displayed, for example to show a total in a toolbar or to export it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Summaries update by themselves when the data is reloaded, the filter or the"},{"type":"text","text":" "},{"type":"text","text":"selection changes (for the selection scopes) or columns are shown. When only"},{"type":"text","text":" "},{"type":"text","text":"the values changed and you don’t need to reload cells, call"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Large tables","anchor":"Large-tables","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Up to "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/synchronousSummaryLimit","type":"reference"},{"type":"text","text":" values (rows × summarized"},{"type":"text","text":" "},{"type":"text","text":"columns, 50,000 by default), summaries are computed during"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadData()","type":"reference"},{"type":"text","text":". Above it, the table shows the rows at once, reads"},{"type":"text","text":" "},{"type":"text","text":"the values in short slices on the main thread, and computes the summaries in"},{"type":"text","text":" "},{"type":"text","text":"the background, so the app stays responsive."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"While it computes, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isComputingSummary"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". Totals over","type":"text"},{"text":" ","type":"text"},{"text":"all rows show the previous values; values that depend on the selection are","type":"text"},{"text":" ","type":"text"},{"text":"blank rather than wrong.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If it takes more than a moment, a small spinner appears in the summary row","type":"text"},{"text":" ","type":"text"},{"text":"and its values dim. Turn it off with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryProgress"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"show progress in your own UI.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableViewDidUpdateSummary(_:)","type":"reference","isActive":true},{"text":" is called when the","type":"text"},{"text":" ","type":"text"},{"text":"values computed in the background are shown.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Reloading again during a computation cancels it and starts over, so a burst","type":"text"},{"text":" ","type":"text"},{"text":"of reloads computes only once.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Once computed, the values are kept compactly, and changing the selection or","type":"text"},{"text":" ","type":"text"},{"text":"scope stays fast even with 100,000 rows: sums over most rows are taken as the","type":"text"},{"text":" ","type":"text"},{"text":"total minus the few other rows.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With a column source (see "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp","type":"reference"},{"type":"text","text":") that gives every"},{"type":"text","text":" "},{"type":"text","text":"summarized column as numbers, the totals are read from it on all cores, off"},{"type":"text","text":" "},{"type":"text","text":"the main thread, and no values are kept; a sort or search of the source goes"},{"type":"text","text":" "},{"type":"text","text":"first, and the totals shown stay until the new ones are read."}],"type":"paragraph"},{"text":"Summaries the app computes","level":3,"type":"heading","anchor":"Summaries-the-app-computes"},{"inlineContent":[{"type":"text","text":"The table keeps each summarized value of every row (8 bytes a row and"},{"type":"text","text":" "},{"type":"text","text":"column): fine for hundreds of thousands of rows, too much for a file of tens"},{"type":"text","text":" "},{"type":"text","text":"of millions. A column source (see "},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp","type":"reference"},{"type":"text","text":") avoids it: the"},{"type":"text","text":" "},{"type":"text","text":"totals of the number columns it gives are read on all cores, off the main"},{"type":"text","text":" "},{"type":"text","text":"thread, and no values are kept (without row grouping, a row tree or"},{"type":"text","text":" "},{"type":"text","text":"automatic color ranges). An app may also sum a column itself: give it the"},{"type":"text","text":" "},{"type":"text","text":"summary "},{"type":"codeVoice","code":".provided"},{"text":", and the summary row shows the text the data source","type":"text"},{"text":" ","type":"text"},{"text":"returns for it, and the table reads no values.","type":"text"}],"type":"paragraph"},{"code":["GHTableColumn(\"amount\", title: \"Amount\", summary: .provided)","","func tableView(_ tableView: GHTableView, summaryFor column: GHTableColumn) -> String? {","    totals[column.id]   \/\/ computed for tableView.summaryScope","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDataSource\/tableView(_:summaryFor:)","isActive":true,"type":"reference"},{"text":" is called whenever the","type":"text"},{"text":" ","type":"text"},{"text":"summary row updates: on reloads, on ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()","isActive":true,"type":"reference"},{"text":", and when","type":"text"},{"text":" ","type":"text"},{"text":"the scope or, in a selection scope, the selection changes. Return what is","type":"text"},{"text":" ","type":"text"},{"text":"ready; compute the rest in the background and call ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"when it is done.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Summaries","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/ngtable.Gingham\/documentation\/Gingham"]]},"variants":[{"paths":["\/documentation\/gingham\/summaries"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","seeAlsoSections":[{"title":"Summaries","identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnSummary","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFilter","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryFormula","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryValues","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryScope"],"anchor":"Summaries","generated":true}],"abstract":[{"type":"text","text":"Show totals, averages and computed values in the summary row, for all rows or"},{"text":" ","type":"text"},{"text":"just the selected ones.","type":"text"}],"references":{"doc://ngtable.Gingham/documentation/Gingham/GHTableView/showsSummaryProgress":{"url":"\/documentation\/gingham\/ghtableview\/showssummaryprogress","abstract":[{"text":"Whether a spinner shows in the summary row, and its values dim, while a","type":"text"},{"text":" ","type":"text"},{"text":"background computation takes more than a moment. Turn it off to show","type":"text"},{"text":" ","type":"text"},{"text":"progress in your own UI (see ","type":"text"},{"code":"isComputingSummary","type":"codeVoice"},{"text":").","type":"text"}],"type":"topic","kind":"symbol","title":"showsSummaryProgress","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryProgress","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"showsSummaryProgress","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"role":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHSummaryScope":{"url":"\/documentation\/gingham\/ghsummaryscope","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHSummaryScope"}],"abstract":[{"text":"Which rows participate in the summary.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"GHSummaryScope"}],"title":"GHSummaryScope","type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryScope","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/showsSummaryRow":{"url":"\/documentation\/gingham\/ghtableview\/showssummaryrow","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"showsSummaryRow","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"abstract":[{"text":"Whether the summary row shows at the bottom of the table (while there","type":"text"},{"text":" ","type":"text"},{"text":"is data, see ","type":"text"},{"code":"emptyStateText","type":"codeVoice"},{"text":").","type":"text"}],"type":"topic","title":"showsSummaryRow","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryRow","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHSummaryFormula":{"url":"\/documentation\/gingham\/ghsummaryformula","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHSummaryFormula"}],"abstract":[{"text":"A summary computed from aggregates of other columns, e.g. the total ROI","type":"text"},{"text":" ","type":"text"},{"code":"(sum of revenue − sum of spend) \/ sum of spend","type":"codeVoice"},{"text":", which, unlike the average","type":"text"},{"text":" ","type":"text"},{"text":"of the rows’ ROI, weighs every row by its spend.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"GHSummaryFormula"}],"title":"GHSummaryFormula","type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryFormula","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHValueFilter":{"role":"symbol","title":"GHValueFilter","url":"\/documentation\/gingham\/ghvaluefilter","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Which values an aggregate takes into account. Empty and non-numeric values"},{"type":"text","text":" "},{"type":"text","text":"are always left out."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFilter","navigatorTitle":[{"text":"GHValueFilter","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHValueFilter"}]},"doc://ngtable.Gingham/documentation/Gingham":{"url":"\/documentation\/gingham","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A fast table for business data on the Mac, iPad and iPhone: frozen columns,"},{"type":"text","text":" "},{"type":"text","text":"column groups, a summary row with formulas, row grouping with subtotals, search and filters, stable"},{"type":"text","text":" "},{"text":"selection across reloads, and live updates.","type":"text"}],"title":"Gingham","role":"collection"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/isComputingSummary":{"url":"\/documentation\/gingham\/ghtableview\/iscomputingsummary","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isComputingSummary"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"abstract":[{"text":"Whether summaries are being computed in the background; the summary row","type":"text"},{"text":" ","type":"text"},{"text":"shows the previous values meanwhile.","type":"text"}],"title":"isComputingSummary","type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isComputingSummary","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/synchronousSummaryLimit":{"url":"\/documentation\/gingham\/ghtableview\/synchronoussummarylimit","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"synchronousSummaryLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"abstract":[{"text":"Up to this many values to read (data source rows × summarized columns),","type":"text"},{"text":" ","type":"text"},{"text":"summaries are computed right away. Above it, ","type":"text"},{"code":"reloadData()","type":"codeVoice"},{"text":" shows the","type":"text"},{"text":" ","type":"text"},{"text":"rows at once and the summary row follows when it has been computed in","type":"text"},{"text":" ","type":"text"},{"text":"the background, keeping the app responsive with large data.","type":"text"}],"title":"synchronousSummaryLimit","type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/synchronousSummaryLimit","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/reloadSummary()":{"url":"\/documentation\/gingham\/ghtableview\/reloads