{"hierarchy":{"paths":[["doc:\/\/ngtable.Gingham\/documentation\/Gingham"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The summary row at the bottom of the table shows one value per column, aligned"},{"type":"text","text":" "},{"type":"text","text":"with the column. What a column shows is its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnSummary"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["GHTableColumn(\"spend\", title: \"Spend\", format: .currency(code: \"EUR\"), summary: .aggregate(.sum))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The summary row holds values only, no captions; use the column’s "},{"type":"codeVoice","code":"toolTip"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"explain a less obvious one (“Average of campaigns that ran”). Values are"},{"type":"text","text":" "},{"type":"text","text":"formatted with the column’s format, except counts, which are whole numbers."},{"type":"text","text":" "},{"text":"Hide the row with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryRow"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only "},{"type":"codeVoice","code":".number"},{"type":"text","text":" values take part, and dates: a column of dates counts them,"},{"type":"text","text":" "},{"type":"text","text":"and its minimum, maximum and average are dates (the earliest, the latest),"},{"type":"text","text":" "},{"type":"text","text":"shown in the column’s date format. Empty values, text, NaN and infinity are"},{"type":"text","text":" "},{"type":"text","text":"left out, so a column where some rows have no value summarizes the others."}],"type":"paragraph"},{"text":"Aggregates","anchor":"Aggregates","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":".aggregate(_:including:)"},{"type":"text","text":" computes an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate"},{"type":"text","text":" of the column’s own"},{"type":"text","text":" "},{"type":"text","text":"values:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Aggregate","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Result","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Without values","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".sum","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The total, summed without rounding drift","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Blank","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".average"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The mean","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Blank","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".count"}],"type":"paragraph"}],[{"inlineContent":[{"text":"How many rows have a number","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"0","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".min","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":".max"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The smallest or largest value"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Blank"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFilter"},{"text":" limits the values: ","type":"text"},{"code":".nonZero","type":"codeVoice"},{"text":", ","type":"text"},{"code":".positive","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":".nonNegative","type":"codeVoice"},{"text":", or your own:","type":"text"}]},{"syntax":"swift","code":["\/\/ The average ROI of the campaigns that actually ran.","summary: .aggregate(.average, including: .nonZero)","","\/\/ A custom filter: give it a unique name.","let large = GHValueFilter(\"atLeast1000\") { $0 >= 1000 }","summary: .aggregate(.count, including: large)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Filters may be called off the main thread, so they must only look at the"},{"type":"text","text":" "},{"type":"text","text":"value."}]},{"level":3,"type":"heading","anchor":"Formulas","text":"Formulas"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Many business totals are not an aggregate of the column’s own values. The"},{"type":"text","text":" "},{"type":"text","text":"total ROI of several campaigns is not the average of their ROIs: a small"},{"type":"text","text":" "},{"type":"text","text":"campaign with +200 % would outweigh a big one with −10 %. It is the ratio of"},{"type":"text","text":" "},{"type":"text","text":"the sums: (Σ revenue − Σ spend) \/ Σ spend. An "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryFormula","isActive":true,"type":"reference"},{"type":"text","text":" computes"},{"type":"text","text":" "},{"type":"text","text":"such values from aggregates of other columns:"}]},{"type":"codeListing","syntax":"swift","code":["static let roi = GHSummaryFormula(\"roi\", using: [\"spend\", \"revenue\"],","                                  otherwise: .average, including: .nonZero) { values in","    guard let spend = values.sum(\"spend\"), spend != 0,","          let revenue = values.sum(\"revenue\") else { return nil }","    return (revenue - spend) \/ spend","}","","GHTableColumn(\"roi\", title: \"ROI\", format: .percent(fractionDigits: 1), summary: .formula(roi))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Other examples:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Metric","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Formula","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"CTR","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Σ clicks \/ Σ impressions","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"CPC","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Σ spend \/ Σ clicks","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"CPA","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Σ spend \/ Σ conversions","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Conversion rate","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Σ conversions \/ Σ clicks","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Margin","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"(Σ revenue − Σ cost) \/ Σ revenue","type":"text"}]}]]],"header":"row"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"inputs","type":"codeVoice"},{"text":" lists every column the formula reads. They don’t need to be shown,","type":"text"},{"text":" ","type":"text"},{"text":"or even defined: the data source is asked for their values by id like for any","type":"text"},{"text":" ","type":"text"},{"text":"column, so a formula can use raw numbers the table doesn’t display.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryValues"},{"text":" gives each input’s sum, average, count, min and max in the","type":"text"},{"text":" ","type":"text"},{"text":"current scope; ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the input has no numbers there.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the value can’t be computed, for example when dividing by","type":"text"},{"text":" ","type":"text"},{"text":"zero. The table then shows the ","type":"text"},{"code":"otherwise","type":"codeVoice"},{"text":" aggregate of the column’s own","type":"text"},{"text":" ","type":"text"},{"text":"values (filtered by ","type":"text"},{"code":"including","type":"codeVoice"},{"text":"), or nothing.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Formulas are compared by name: give every different formula its own name,","type":"text"},{"text":" ","type":"text"},{"text":"and keep it a pure function of its inputs (it may run off the main thread).","type":"text"}]}]}]},{"anchor":"Scopes","level":3,"type":"heading","text":"Scopes"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryScope","isActive":true,"type":"reference"},{"type":"text","text":" chooses the rows the summaries cover"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryScope","isActive":true,"type":"reference"},{"type":"text","text":"):"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".allRows","type":"codeVoice"},{"text":": every row shown (after the filter);","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".selectedRows","type":"codeVoice"},{"text":": the selected rows;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".excludingSelectedRows"},{"type":"text","text":": every row shown except the selected ones, for"},{"type":"text","text":" "},{"type":"text","text":"“what if we stopped these campaigns?”."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Users change the scope from the summary row’s context menu; the table reports"},{"type":"text","text":" "},{"type":"text","text":"it with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:summaryScopeDidChange:)"},{"type":"text","text":", so you can"},{"type":"text","text":" "},{"type":"text","text":"update your own controls. The menu titles are localized in English and"},{"type":"text","text":" "},{"type":"text","text":"Russian; change them with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryScopeTitles"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Summaries always cover the rows the filter shows, never rows it hides."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/rowGrouping"},{"type":"text","text":", every group header shows subtotals with"},{"type":"text","text":" "},{"type":"text","text":"the same aggregates and formulas over the group’s rows (see"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GroupingRows"},{"type":"text","text":"); the summary row keeps covering all rows of its scope."}]},{"type":"heading","anchor":"Reading-summary-values","level":3,"text":"Reading summary values"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryValue(forColumnID:)"},{"type":"text","text":" returns the value of a column in the"},{"type":"text","text":" "},{"type":"text","text":"current scope, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryText(forColumnID:)"},{"type":"text","text":" the text as"},{"type":"text","text":" "},{"type":"text","text":"displayed, for example to show a total in a toolbar or to export it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Summaries update by themselves when the data is reloaded, the filter or the"},{"type":"text","text":" "},{"type":"text","text":"selection changes (for the selection scopes) or columns are shown. When only"},{"type":"text","text":" "},{"type":"text","text":"the values changed and you don’t need to reload cells, call"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Large-tables","level":3,"text":"Large tables"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Up to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/synchronousSummaryLimit"},{"type":"text","text":" values (rows × summarized"},{"type":"text","text":" "},{"type":"text","text":"columns, 50,000 by default), summaries are computed during"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadData()"},{"type":"text","text":". Above it, the table shows the rows at once, reads"},{"type":"text","text":" "},{"type":"text","text":"the values in short slices on the main thread, and computes the summaries in"},{"type":"text","text":" "},{"type":"text","text":"the background, so the app stays responsive."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"While it computes, "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isComputingSummary","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":". Totals over"},{"type":"text","text":" "},{"type":"text","text":"all rows show the previous values; values that depend on the selection are"},{"type":"text","text":" "},{"type":"text","text":"blank rather than wrong."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If it takes more than a moment, a small spinner appears in the summary row"},{"type":"text","text":" "},{"type":"text","text":"and its values dim. Turn it off with "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryProgress","isActive":true},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"show progress in your own UI."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableViewDidUpdateSummary(_:)","isActive":true},{"type":"text","text":" is called when the"},{"type":"text","text":" "},{"type":"text","text":"values computed in the background are shown."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reloading again during a computation cancels it and starts over, so a burst"},{"type":"text","text":" "},{"type":"text","text":"of reloads computes only once."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once computed, the values are kept compactly, and changing the selection or"},{"type":"text","text":" "},{"type":"text","text":"scope stays fast even with 100,000 rows: sums over most rows are taken as the"},{"type":"text","text":" "},{"type":"text","text":"total minus the few other rows."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With a column source (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp"},{"type":"text","text":") that gives every"},{"type":"text","text":" "},{"type":"text","text":"summarized column as numbers, the totals are read from it on all cores, off"},{"type":"text","text":" "},{"type":"text","text":"the main thread, and no values are kept; a sort or search of the source goes"},{"type":"text","text":" "},{"type":"text","text":"first, and the totals shown stay until the new ones are read."}]},{"type":"heading","anchor":"Summaries-the-app-computes","level":3,"text":"Summaries the app computes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The table keeps each summarized value of every row (8 bytes a row and"},{"type":"text","text":" "},{"type":"text","text":"column): fine for hundreds of thousands of rows, too much for a file of tens"},{"type":"text","text":" "},{"type":"text","text":"of millions. A column source (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp"},{"type":"text","text":") avoids it: the"},{"type":"text","text":" "},{"type":"text","text":"totals of the number columns it gives are read on all cores, off the main"},{"type":"text","text":" "},{"type":"text","text":"thread, and no values are kept (without row grouping, a row tree or"},{"type":"text","text":" "},{"type":"text","text":"automatic color ranges). An app may also sum a column itself: give it the"},{"type":"text","text":" "},{"type":"text","text":"summary "},{"type":"codeVoice","code":".provided"},{"type":"text","text":", and the summary row shows the text the data source"},{"type":"text","text":" "},{"type":"text","text":"returns for it, and the table reads no values."}]},{"type":"codeListing","syntax":"swift","code":["GHTableColumn(\"amount\", title: \"Amount\", summary: .provided)","","func tableView(_ tableView: GHTableView, summaryFor column: GHTableColumn) -> String? {","    totals[column.id]   \/\/ computed for tableView.summaryScope","}"]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDataSource\/tableView(_:summaryFor:)"},{"type":"text","text":" is called whenever the"},{"type":"text","text":" "},{"type":"text","text":"summary row updates: on reloads, on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()"},{"type":"text","text":", and when"},{"type":"text","text":" "},{"type":"text","text":"the scope or, in a selection scope, the selection changes. Return what is"},{"type":"text","text":" "},{"type":"text","text":"ready; compute the rest in the background and call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()"},{"type":"text","text":" "},{"type":"text","text":"when it is done."}]}]}],"abstract":[{"text":"Show totals, averages and computed values in the summary row, for all rows or","type":"text"},{"text":" ","type":"text"},{"text":"just the selected ones.","type":"text"}],"variants":[{"paths":["\/documentation\/gingham\/summaries"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Summaries"},"seeAlsoSections":[{"anchor":"Summaries","identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnSummary","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFilter","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryFormula","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryValues","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryScope"],"generated":true,"title":"Summaries"}],"metadata":{"role":"article","roleHeading":"Article","title":"Summaries","modules":[{"name":"Gingham"}]},"sections":[],"references":{"doc://ngtable.Gingham/documentation/Gingham/GHTableView/synchronousSummaryLimit":{"kind":"symbol","role":"symbol","abstract":[{"text":"Up to this many values to read (data source rows × summarized columns),","type":"text"},{"text":" ","type":"text"},{"text":"summaries are computed right away. Above it, ","type":"text"},{"code":"reloadData()","type":"codeVoice"},{"text":" shows the","type":"text"},{"text":" ","type":"text"},{"text":"rows at once and the summary row follows when it has been computed in","type":"text"},{"text":" ","type":"text"},{"text":"the background, keeping the app responsive with large data.","type":"text"}],"title":"synchronousSummaryLimit","type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/synchronousSummaryLimit","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"synchronousSummaryLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"url":"\/documentation\/gingham\/ghtableview\/synchronoussummarylimit"},"doc://ngtable.Gingham/documentation/Gingham/GHAggregate":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHAggregate"}],"abstract":[{"text":"Aggregate function computed in the summary row.","type":"text"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","title":"GHAggregate","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GHAggregate"}],"url":"\/documentation\/gingham\/ghaggregate"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/reloadSummary()":{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reloadSummary","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/gingham\/ghtableview\/reloadsummary()","role":"symbol","abstract":[{"text":"Recomputes the summary row without reloading cells.","type":"text"}],"title":"reloadSummary()","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/GHTableViewDelegate/tableViewDidUpdateSummary(_:)":{"abstract":[{"type":"text","text":"Called when summaries computed in the background (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"GHTableView.synchronousSummaryLimit"},{"type":"text","text":") are ready and shown."}],"defaultImplementations":1,"required":true,"role":"symbol","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableViewDidUpdateSummary(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tableViewDidUpdateSummary"},{"kind":"text","text":"("},{"preciseIdentifier":"c:@M@Gingham@objc(cs)GHTableView","kind":"typeIdentifier","text":"GHTableView"},{"kind":"text","text":")"}],"url":"\/documentation\/gingham\/ghtableviewdelegate\/tableviewdidupdatesummary(_:)","title":"tableViewDidUpdateSummary(_:)","kind":"symbol","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/summaryScopeTitles":{"url":"\/documentation\/gingham\/ghtableview\/summaryscopetitles","title":"summaryScopeTitles","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"summaryScopeTitles","kind":"identifier"},{"text":": [","kind":"text"},{"text":"GHSummaryScope","preciseIdentifier":"s:7Gingham14GHSummaryScopeO","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryScopeTitles","abstract":[{"type":"text","text":"Titles of the summary row context menu, localized (English, Russian) by default."}],"kind":"symbol","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/rowGrouping":{"kind":"symbol","abstract":[{"type":"text","text":"Groups the rows by the values of some columns, under header rows with"},{"type":"text","text":" "},{"type":"text","text":"subtotals that the user collapses and expands (see "},{"type":"codeVoice","code":"GHRowGrouping"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" shows the rows as they come. Header rows are display rows"},{"text":" ","type":"text"},{"text":"(they count in ","type":"text"},{"code":"numberOfRows","type":"codeVoice"},{"type":"text","text":") but not data source rows: they’re never"},{"text":" ","type":"text"},{"type":"text","text":"selected, and "},{"type":"codeVoice","code":"row(at:)"},{"type":"text","text":" gives -1 for them (see "},{"type":"codeVoice","code":"group(at:)"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Setting another grouping keeps the selected rows that stay shown and"},{"text":" ","type":"text"},{"type":"text","text":"forgets which groups were collapsed; setting the one it is changes"},{"type":"text","text":" "},{"type":"text","text":"nothing (its groups stay collapsed or expanded)."}],"url":"\/documentation\/gingham\/ghtableview\/rowgrouping","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rowGrouping"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GHRowGrouping","preciseIdentifier":"s:7Gingham13GHRowGroupingV"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/rowGrouping","role":"symbol","title":"rowGrouping","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/IntegratingIntoAnApp":{"kind":"article","url":"\/documentation\/gingham\/integratingintoanapp","abstract":[{"type":"text","text":"A complete setup for records loaded from a server: columns, data source,"},{"type":"text","text":" "},{"type":"text","text":"identity, sorting, search, filters, summaries, menus and refreshing."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp","role":"article","title":"Integrating into an App","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/GHTabl