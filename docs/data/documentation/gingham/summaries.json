{"seeAlsoSections":[{"title":"Summaries","generated":true,"anchor":"Summaries","identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnSummary","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFilter","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryFormula","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryValues","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryScope"]}],"metadata":{"role":"article","title":"Summaries","modules":[{"name":"Gingham"}],"roleHeading":"Article"},"abstract":[{"type":"text","text":"Show totals, averages and computed values in the summary row, for all rows or"},{"type":"text","text":" "},{"type":"text","text":"just the selected ones."}],"variants":[{"paths":["\/documentation\/gingham\/summaries"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Summaries","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/ngtable.Gingham\/documentation\/Gingham"]]},"sections":[],"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The summary row at the bottom of the table shows one value per column, aligned","type":"text"},{"text":" ","type":"text"},{"text":"with the column. What a column shows is its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnSummary","type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","code":["GHTableColumn(\"spend\", title: \"Spend\", format: .currency(code: \"EUR\"), summary: .aggregate(.sum))"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The summary row holds values only, no captions; use the column’s ","type":"text"},{"code":"toolTip","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"explain a less obvious one (“Average of campaigns that ran”). Values are","type":"text"},{"text":" ","type":"text"},{"text":"formatted with the column’s format, except counts, which are whole numbers.","type":"text"},{"text":" ","type":"text"},{"text":"Hide the row with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryRow","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Only ","type":"text"},{"code":".number","type":"codeVoice"},{"text":" values take part, and dates: a column of dates counts them,","type":"text"},{"text":" ","type":"text"},{"text":"and its minimum, maximum and average are dates (the earliest, the latest),","type":"text"},{"text":" ","type":"text"},{"text":"shown in the column’s date format. Empty values, text, NaN and infinity are","type":"text"},{"text":" ","type":"text"},{"text":"left out, so a column where some rows have no value summarizes the others.","type":"text"}]},{"level":3,"type":"heading","anchor":"Aggregates","text":"Aggregates"},{"type":"paragraph","inlineContent":[{"code":".aggregate(_:including:)","type":"codeVoice"},{"text":" computes an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","type":"reference"},{"text":" of the column’s own","type":"text"},{"text":" ","type":"text"},{"text":"values:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Aggregate","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Result","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Without values","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".sum"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The total, summed without rounding drift","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Blank","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".average"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The mean","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Blank","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".count"}],"type":"paragraph"}],[{"inlineContent":[{"text":"How many rows have a number","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"0","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".min"},{"text":", ","type":"text"},{"type":"codeVoice","code":".max"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The smallest or largest value","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Blank","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFilter","type":"reference"},{"text":" limits the values: ","type":"text"},{"code":".nonZero","type":"codeVoice"},{"text":", ","type":"text"},{"code":".positive","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":".nonNegative","type":"codeVoice"},{"text":", or your own:","type":"text"}]},{"syntax":"swift","code":["\/\/ The average ROI of the campaigns that actually ran.","summary: .aggregate(.average, including: .nonZero)","","\/\/ A custom filter: give it a unique name.","let large = GHValueFilter(\"atLeast1000\") { $0 >= 1000 }","summary: .aggregate(.count, including: large)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Filters may be called off the main thread, so they must only look at the","type":"text"},{"text":" ","type":"text"},{"text":"value.","type":"text"}]},{"level":3,"type":"heading","anchor":"Formulas","text":"Formulas"},{"type":"paragraph","inlineContent":[{"text":"Many business totals are not an aggregate of the column’s own values. The","type":"text"},{"text":" ","type":"text"},{"text":"total ROI of several campaigns is not the average of their ROIs: a small","type":"text"},{"text":" ","type":"text"},{"text":"campaign with +200 % would outweigh a big one with −10 %. It is the ratio of","type":"text"},{"text":" ","type":"text"},{"text":"the sums: (Σ revenue − Σ spend) \/ Σ spend. An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryFormula","type":"reference"},{"text":" computes","type":"text"},{"text":" ","type":"text"},{"text":"such values from aggregates of other columns:","type":"text"}]},{"syntax":"swift","code":["static let roi = GHSummaryFormula(\"roi\", using: [\"spend\", \"revenue\"],","                                  otherwise: .average, including: .nonZero) { values in","    guard let spend = values.sum(\"spend\"), spend != 0,","          let revenue = values.sum(\"revenue\") else { return nil }","    return (revenue - spend) \/ spend","}","","GHTableColumn(\"roi\", title: \"ROI\", format: .percent(fractionDigits: 1), summary: .formula(roi))"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Other examples:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Metric","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Formula","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"CTR","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Σ clicks \/ Σ impressions","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"CPC","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Σ spend \/ Σ clicks","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"CPA","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Σ spend \/ Σ conversions","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Conversion rate","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Σ conversions \/ Σ clicks","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Margin","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"(Σ revenue − Σ cost) \/ Σ revenue","type":"text"}],"type":"paragraph"}]]]},{"items":[{"content":[{"inlineContent":[{"code":"inputs","type":"codeVoice"},{"text":" lists every column the formula reads. They don’t need to be shown,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"or even defined: the data source is asked for their values by id like for any"},{"type":"text","text":" "},{"type":"text","text":"column, so a formula can use raw numbers the table doesn’t display."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryValues","type":"reference"},{"type":"text","text":" gives each input’s sum, average, count, min and max in the"},{"type":"text","text":" "},{"text":"current scope; ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the input has no numbers there.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the value can’t be computed, for example when dividing by","type":"text"},{"text":" ","type":"text"},{"text":"zero. The table then shows the ","type":"text"},{"code":"otherwise","type":"codeVoice"},{"text":" aggregate of the column’s own","type":"text"},{"text":" ","type":"text"},{"text":"values (filtered by ","type":"text"},{"code":"including","type":"codeVoice"},{"text":"), or nothing.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Formulas are compared by name: give every different formula its own name,","type":"text"},{"text":" ","type":"text"},{"text":"and keep it a pure function of its inputs (it may run off the main thread).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Scopes","level":3,"type":"heading","anchor":"Scopes"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryScope"},{"type":"text","text":" chooses the rows the summaries cover"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryScope"},{"type":"text","text":"):"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":".allRows","type":"codeVoice"},{"text":": every row shown (after the filter);","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".selectedRows","type":"codeVoice"},{"text":": the selected rows;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".excludingSelectedRows","type":"codeVoice"},{"text":": every row shown except the selected ones, for","type":"text"},{"text":" ","type":"text"},{"text":"“what if we stopped these campaigns?”.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Users change the scope from the summary row’s context menu; the table reports"},{"type":"text","text":" "},{"type":"text","text":"it with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:summaryScopeDidChange:)"},{"type":"text","text":", so you can"},{"type":"text","text":" "},{"type":"text","text":"update your own controls. The menu titles are localized in English and"},{"type":"text","text":" "},{"type":"text","text":"Russian; change them with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryScopeTitles"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Summaries always cover the rows the filter shows, never rows it hides."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/rowGrouping"},{"type":"text","text":", every group header shows subtotals with"},{"type":"text","text":" "},{"type":"text","text":"the same aggregates and formulas over the group’s rows (see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GroupingRows"},{"type":"text","text":"); the summary row keeps covering all rows of its scope."}],"type":"paragraph"},{"text":"Reading summary values","level":3,"type":"heading","anchor":"Reading-summary-values"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryValue(forColumnID:)"},{"type":"text","text":" returns the value of a column in the"},{"type":"text","text":" "},{"type":"text","text":"current scope, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryText(forColumnID:)"},{"type":"text","text":" the text as"},{"type":"text","text":" "},{"type":"text","text":"displayed, for example to show a total in a toolbar or to export it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Summaries update by themselves when the data is reloaded, the filter or the"},{"type":"text","text":" "},{"type":"text","text":"selection changes (for the selection scopes) or columns are shown. When only"},{"type":"text","text":" "},{"type":"text","text":"the values changed and you don’t need to reload cells, call"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Large tables","level":3,"type":"heading","anchor":"Large-tables"},{"inlineContent":[{"type":"text","text":"Up to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/synchronousSummaryLimit"},{"type":"text","text":" values (rows × summarized"},{"type":"text","text":" "},{"type":"text","text":"columns, 50,000 by default), summaries are computed during"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadData()"},{"type":"text","text":". Above it, the table shows the rows at once, reads"},{"type":"text","text":" "},{"type":"text","text":"the values in short slices on the main thread, and computes the summaries in"},{"type":"text","text":" "},{"type":"text","text":"the background, so the app stays responsive."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"While it computes, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isComputingSummary","type":"reference"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". Totals over","type":"text"},{"text":" ","type":"text"},{"text":"all rows show the previous values; values that depend on the selection are","type":"text"},{"text":" ","type":"text"},{"text":"blank rather than wrong.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If it takes more than a moment, a small spinner appears in the summary row","type":"text"},{"text":" ","type":"text"},{"text":"and its values dim. Turn it off with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryProgress","type":"reference"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"show progress in your own UI.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableViewDidUpdateSummary(_:)","type":"reference"},{"text":" is called when the","type":"text"},{"text":" ","type":"text"},{"text":"values computed in the background are shown.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Reloading again during a computation cancels it and starts over, so a burst","type":"text"},{"text":" ","type":"text"},{"text":"of reloads computes only once.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Once computed, the values are kept compactly, and changing the selection or"},{"type":"text","text":" "},{"type":"text","text":"scope stays fast even with 100,000 rows: sums over most rows are taken as the"},{"type":"text","text":" "},{"type":"text","text":"total minus the few other rows."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With a column source (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp"},{"type":"text","text":") that gives every"},{"type":"text","text":" "},{"type":"text","text":"summarized column as numbers, the totals are read from it on all cores, off"},{"type":"text","text":" "},{"type":"text","text":"the main thread, and no values are kept; a sort or search of the source goes"},{"type":"text","text":" "},{"type":"text","text":"first, and the totals shown stay until the new ones are read."}],"type":"paragraph"},{"text":"Summaries the app computes","level":3,"type":"heading","anchor":"Summaries-the-app-computes"},{"inlineContent":[{"type":"text","text":"The table keeps each summarized value of every row (8 bytes a row and"},{"type":"text","text":" "},{"type":"text","text":"column): fine for hundreds of thousands of rows, too much for a file of tens"},{"type":"text","text":" "},{"type":"text","text":"of millions. A column source (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp"},{"type":"text","text":") avoids it: the"},{"type":"text","text":" "},{"type":"text","text":"totals of the number columns it gives are read on all cores, off the main"},{"type":"text","text":" "},{"type":"text","text":"thread, and no values are kept (without row grouping, a row tree or"},{"type":"text","text":" "},{"type":"text","text":"automatic color ranges). An app may also sum a column itself: give it the"},{"type":"text","text":" "},{"type":"text","text":"summary "},{"code":".provided","type":"codeVoice"},{"type":"text","text":", and the summary row shows the text the data source"},{"type":"text","text":" "},{"type":"text","text":"returns for it, and the table reads no values."}],"type":"paragraph"},{"type":"codeListing","code":["GHTableColumn(\"amount\", title: \"Amount\", summary: .provided)","","func tableView(_ tableView: GHTableView, summaryFor column: GHTableColumn) -> String? {","    totals[column.id]   \/\/ computed for tableView.summaryScope","}"],"syntax":"swift"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDataSource\/tableView(_:summaryFor:)"},{"type":"text","text":" is called whenever the"},{"type":"text","text":" "},{"type":"text","text":"summary row updates: on reloads, on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()"},{"type":"text","text":", and when"},{"type":"text","text":" "},{"type":"text","text":"the scope or, in a selection scope, the selection changes. Return what is"},{"type":"text","text":" "},{"type":"text","text":"ready; compute the rest in the background and call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()"},{"type":"text","text":" "},{"type":"text","text":"when it is done."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://ngtable.Gingham/documentation/Gingham/GHAggregate":{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","type":"topic","title":"GHAggregate","navigatorTitle":[{"kind":"identifier","text":"GHAggregate"}],"kind":"symbol","role":"symbol","url":"\/documentation\/gingham\/ghaggregate","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHAggregate"}],"abstract":[{"text":"Aggregate function computed in the summary row.","type":"text"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/synchronousSummaryLimit":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/synchronousSummaryLimit","title":"synchronousSummaryLimit","kind":"symbol","role":"symbol","url":"\/documentation\/gingham\/ghtableview\/synchronoussummarylimit","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"synchronousSummaryLimit","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"abstract":[{"type":"text","text":"Up to this many values to read (data source rows × summarized columns),"},{"type":"text","text":" "},{"type":"text","text":"summaries are computed right away. Above it, "},{"type":"codeVoice","code":"reloadData()"},{"type":"text","text":" shows the"},{"type":"text","text":" "},{"type":"text","text":"rows at once and the summary row follows when it has been computed in"},{"type":"text","text":" "},{"type":"text","text":"the background, keeping the app responsive with large data."}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/showsSummaryRow":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryRow","title":"showsSummaryRow","kind":"symbol","role":"symbol","url":"\/documentation\/gingham\/ghtableview\/showssummaryrow","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"showsSummaryRow","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"text":"Whether the summary row shows at the bottom of the table (while there","type":"text"},{"text":" ","type":"text"},{"text":"is data, see ","type":"text"},{"code":"emptyStateText","type":"codeVoice"},{"text":").","type":"text"}]},"doc://ngtable.Gingham/documentation/Gingham/GHValueFilter":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFilter","title":"GHValueFilter","role":"symbol","abstract":[{"type":"text","text":"Which values an aggregate takes into account. Empty and non-numeric values"},{"text":" ","type":"text"},{"type":"text","text":"are always left out."}],"url":"\/documentation\/gingham\/ghvaluefilter","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"GHValueFilter","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GHValueFilter"}]},"doc://ngtable.Gingham/documentation/Gingham/GHSummaryValues":{"kind":"symbol","title":"GHSummaryValues","abstract":[{"text":"Aggregates of other columns in the current summary scope, passed to a","type":"text"},{"type":"text","text":" "},{"text":"summary formula.","type":"text"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryValues","type":"topic","url":"\/documentation\/gingham\/ghsummaryvalues","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHSummaryValues"}],"navigatorTitle":[{"kind":"identifier","text":"GHSummaryValues"}]},"doc://ngtable.Gingham/documentation/Gingham/GroupingRows":{"abstract":[{"type":"text","text":"Gather rows under collapsible header rows with subtotals."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GroupingRows","title":"Grouping Rows","url":"\/documentation\/gingham\/groupingrows","type":"topic","role":"collectionGroup","kind":"article"},"doc://ngtable.Gingham/documentation/Gingham/GHTableViewDelegate/tableViewDidUpdateSummary(_:)":{"required":true,"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identi