{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The summary row at the bottom of the table shows one value per column, aligned"},{"type":"text","text":" "},{"type":"text","text":"with the column. What a column shows is its "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnSummary","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["GHTableColumn(\"spend\", title: \"Spend\", format: .currency(code: \"EUR\"), summary: .aggregate(.sum))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The summary row holds values only, no captions; use the column’s "},{"code":"toolTip","type":"codeVoice"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"explain a less obvious one (“Average of campaigns that ran”). Values are"},{"type":"text","text":" "},{"type":"text","text":"formatted with the column’s format, except counts, which are whole numbers."},{"type":"text","text":" "},{"type":"text","text":"Hide the row with "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryRow","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only "},{"code":".number","type":"codeVoice"},{"type":"text","text":" values take part, and dates: a column of dates counts them,"},{"type":"text","text":" "},{"type":"text","text":"and its minimum, maximum and average are dates (the earliest, the latest),"},{"type":"text","text":" "},{"type":"text","text":"shown in the column’s date format. Empty values, text, NaN and infinity are"},{"type":"text","text":" "},{"type":"text","text":"left out, so a column where some rows have no value summarizes the others."}],"type":"paragraph"},{"text":"Aggregates","level":3,"anchor":"Aggregates","type":"heading"},{"inlineContent":[{"code":".aggregate(_:including:)","type":"codeVoice"},{"type":"text","text":" computes an "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","type":"reference","isActive":true},{"type":"text","text":" of the column’s own"},{"type":"text","text":" "},{"type":"text","text":"values:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Aggregate"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Result"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Without values"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".sum"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The total, summed without rounding drift"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Blank"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".average"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The mean"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Blank"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".count"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"How many rows have a number"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"0"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".min"},{"type":"text","text":", "},{"type":"codeVoice","code":".max"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The smallest or largest value"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Blank"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFilter","type":"reference","isActive":true},{"type":"text","text":" limits the values: "},{"code":".nonZero","type":"codeVoice"},{"type":"text","text":", "},{"code":".positive","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":".nonNegative","type":"codeVoice"},{"type":"text","text":", or your own:"}],"type":"paragraph"},{"code":["\/\/ The average ROI of the campaigns that actually ran.","summary: .aggregate(.average, including: .nonZero)","","\/\/ A custom filter: give it a unique name.","let large = GHValueFilter(\"atLeast1000\") { $0 >= 1000 }","summary: .aggregate(.count, including: large)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Filters may be called off the main thread, so they must only look at the"},{"type":"text","text":" "},{"type":"text","text":"value."}],"type":"paragraph"},{"text":"Formulas","level":3,"anchor":"Formulas","type":"heading"},{"inlineContent":[{"type":"text","text":"Many business totals are not an aggregate of the column’s own values. The"},{"type":"text","text":" "},{"type":"text","text":"total ROI of several campaigns is not the average of their ROIs: a small"},{"type":"text","text":" "},{"type":"text","text":"campaign with +200 % would outweigh a big one with −10 %. It is the ratio of"},{"type":"text","text":" "},{"type":"text","text":"the sums: (Σ revenue − Σ spend) \/ Σ spend. An "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryFormula","type":"reference","isActive":true},{"type":"text","text":" computes"},{"type":"text","text":" "},{"type":"text","text":"such values from aggregates of other columns:"}],"type":"paragraph"},{"code":["static let roi = GHSummaryFormula(\"roi\", using: [\"spend\", \"revenue\"],","                                  otherwise: .average, including: .nonZero) { values in","    guard let spend = values.sum(\"spend\"), spend != 0,","          let revenue = values.sum(\"revenue\") else { return nil }","    return (revenue - spend) \/ spend","}","","GHTableColumn(\"roi\", title: \"ROI\", format: .percent(fractionDigits: 1), summary: .formula(roi))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Other examples:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Metric"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Formula"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"CTR"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Σ clicks \/ Σ impressions"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"CPC"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Σ spend \/ Σ clicks"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"CPA"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Σ spend \/ Σ conversions"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Conversion rate"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Σ conversions \/ Σ clicks"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Margin"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"(Σ revenue − Σ cost) \/ Σ revenue"}],"type":"paragraph"}]]],"type":"table"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"inputs","type":"codeVoice"},{"type":"text","text":" lists every column the formula reads. They don’t need to be shown,"},{"type":"text","text":" "},{"type":"text","text":"or even defined: the data source is asked for their values by id like for any"},{"type":"text","text":" "},{"type":"text","text":"column, so a formula can use raw numbers the table doesn’t display."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryValues","isActive":true},{"type":"text","text":" gives each input’s sum, average, count, min and max in the"},{"type":"text","text":" "},{"type":"text","text":"current scope; "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the input has no numbers there."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the value can’t be computed, for example when dividing by"},{"type":"text","text":" "},{"type":"text","text":"zero. The table then shows the "},{"code":"otherwise","type":"codeVoice"},{"type":"text","text":" aggregate of the column’s own"},{"type":"text","text":" "},{"type":"text","text":"values (filtered by "},{"code":"including","type":"codeVoice"},{"type":"text","text":"), or nothing."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Formulas are compared by name: give every different formula its own name,"},{"type":"text","text":" "},{"type":"text","text":"and keep it a pure function of its inputs (it may run off the main thread)."}]}]}]},{"text":"Scopes","level":3,"anchor":"Scopes","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryScope","type":"reference","isActive":true},{"type":"text","text":" chooses the rows the summaries cover"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryScope","type":"reference","isActive":true},{"type":"text","text":"):"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".allRows","type":"codeVoice"},{"type":"text","text":": every row shown (after the filter);"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".selectedRows","type":"codeVoice"},{"type":"text","text":": the selected rows;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".excludingSelectedRows","type":"codeVoice"},{"type":"text","text":": every row shown except the selected ones, for"},{"type":"text","text":" "},{"type":"text","text":"“what if we stopped these campaigns?”."}]}]}]},{"inlineContent":[{"type":"text","text":"Users change the scope from the summary row’s context menu; the table reports"},{"type":"text","text":" "},{"type":"text","text":"it with "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:summaryScopeDidChange:)","type":"reference","isActive":true},{"type":"text","text":", so you can"},{"type":"text","text":" "},{"type":"text","text":"update your own controls. The menu titles are localized in English and"},{"type":"text","text":" "},{"type":"text","text":"Russian; change them with "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryScopeTitles","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Summaries always cover the rows the filter shows, never rows it hides."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/rowGrouping","type":"reference","isActive":true},{"type":"text","text":", every group header shows subtotals with"},{"type":"text","text":" "},{"type":"text","text":"the same aggregates and formulas over the group’s rows (see"},{"type":"text","text":" "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GroupingRows","type":"reference","isActive":true},{"type":"text","text":"); the summary row keeps covering all rows of its scope."}],"type":"paragraph"},{"text":"Reading summary values","level":3,"anchor":"Reading-summary-values","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryValue(forColumnID:)","type":"reference","isActive":true},{"type":"text","text":" returns the value of a column in the"},{"type":"text","text":" "},{"type":"text","text":"current scope, and "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/summaryText(forColumnID:)","type":"reference","isActive":true},{"type":"text","text":" the text as"},{"type":"text","text":" "},{"type":"text","text":"displayed, for example to show a total in a toolbar or to export it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Summaries update by themselves when the data is reloaded, the filter or the"},{"type":"text","text":" "},{"type":"text","text":"selection changes (for the selection scopes) or columns are shown. When only"},{"type":"text","text":" "},{"type":"text","text":"the values changed and you don’t need to reload cells, call"},{"type":"text","text":" "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Large tables","level":3,"anchor":"Large-tables","type":"heading"},{"inlineContent":[{"type":"text","text":"Up to "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/synchronousSummaryLimit","type":"reference","isActive":true},{"type":"text","text":" values (rows × summarized"},{"type":"text","text":" "},{"type":"text","text":"columns, 50,000 by default), summaries are computed during"},{"type":"text","text":" "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadData()","type":"reference","isActive":true},{"type":"text","text":". Above it, the table shows the rows at once, reads"},{"type":"text","text":" "},{"type":"text","text":"the values in short slices on the main thread, and computes the summaries in"},{"type":"text","text":" "},{"type":"text","text":"the background, so the app stays responsive."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"While it computes, "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isComputingSummary","isActive":true},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":". Totals over"},{"type":"text","text":" "},{"type":"text","text":"all rows show the previous values; values that depend on the selection are"},{"type":"text","text":" "},{"type":"text","text":"blank rather than wrong."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If it takes more than a moment, a small spinner appears in the summary row"},{"type":"text","text":" "},{"type":"text","text":"and its values dim. Turn it off with "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryProgress","isActive":true},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"show progress in your own UI."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableViewDidUpdateSummary(_:)","isActive":true},{"type":"text","text":" is called when the"},{"type":"text","text":" "},{"type":"text","text":"values computed in the background are shown."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reloading again during a computation cancels it and starts over, so a burst"},{"type":"text","text":" "},{"type":"text","text":"of reloads computes only once."}]}]}]},{"inlineContent":[{"type":"text","text":"Once computed, the values are kept compactly, and changing the selection or"},{"type":"text","text":" "},{"type":"text","text":"scope stays fast even with 100,000 rows: sums over most rows are taken as the"},{"type":"text","text":" "},{"type":"text","text":"total minus the few other rows."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With a column source (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp"},{"type":"text","text":") that gives every"},{"type":"text","text":" "},{"type":"text","text":"summarized column as numbers, the totals are read from it on all cores, off"},{"type":"text","text":" "},{"type":"text","text":"the main thread, and no values are kept; a sort or search of the source goes"},{"type":"text","text":" "},{"type":"text","text":"first, and the totals shown stay until the new ones are read."}],"type":"paragraph"},{"text":"Summaries the app computes","level":3,"anchor":"Summaries-the-app-computes","type":"heading"},{"inlineContent":[{"type":"text","text":"The table keeps each summarized value of every row (8 bytes a row and"},{"type":"text","text":" "},{"type":"text","text":"column): fine for hundreds of thousands of rows, too much for a file of tens"},{"type":"text","text":" "},{"type":"text","text":"of millions. A column source (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp"},{"type":"text","text":") avoids it: the"},{"type":"text","text":" "},{"type":"text","text":"totals of the number columns it gives are read on all cores, off the main"},{"type":"text","text":" "},{"type":"text","text":"thread, and no values are kept (without row grouping, a row tree or"},{"type":"text","text":" "},{"type":"text","text":"automatic color ranges). An app may also sum a column itself: give it the"},{"type":"text","text":" "},{"type":"text","text":"summary "},{"type":"codeVoice","code":".provided"},{"type":"text","text":", and the summary row shows the text the data source"},{"type":"text","text":" "},{"type":"text","text":"returns for it, and the table reads no values."}],"type":"paragraph"},{"code":["GHTableColumn(\"amount\", title: \"Amount\", summary: .provided)","","func tableView(_ tableView: GHTableView, summaryFor column: GHTableColumn) -> String? {","    totals[column.id]   \/\/ computed for tableView.summaryScope","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDataSource\/tableView(_:summaryFor:)"},{"type":"text","text":" is called whenever the"},{"type":"text","text":" "},{"type":"text","text":"summary row updates: on reloads, on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()"},{"type":"text","text":", and when"},{"type":"text","text":" "},{"type":"text","text":"the scope or, in a selection scope, the selection changes. Return what is"},{"type":"text","text":" "},{"type":"text","text":"ready; compute the rest in the background and call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()"},{"type":"text","text":" "},{"type":"text","text":"when it is done."}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/ngtable.Gingham\/documentation\/Gingham"]]},"variants":[{"paths":["\/documentation\/gingham\/summaries"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHColumnSummary","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFilter","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryFormula","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryValues","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryScope"],"generated":true,"title":"Summaries","anchor":"Summaries"}],"metadata":{"roleHeading":"Article","modules":[{"name":"Gingham"}],"role":"article","title":"Summaries"},"abstract":[{"text":"Show totals, averages and computed values in the summary row, for all rows or","type":"text"},{"text":" ","type":"text"},{"text":"just the selected ones.","type":"text"}],"identifier":{"url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Summaries","interfaceLanguage":"swift"},"references":{"doc://ngtable.Gingham/documentation/Gingham/GHAggregate":{"abstract":[{"type":"text","text":"Aggregate function computed in the summary row."}],"navigatorTitle":[{"text":"GHAggregate","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/gingham\/ghaggregate","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHAggregate","type":"topic","title":"GHAggregate","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GHAggregate","kind":"identifier"}],"role":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHSummaryScope":{"abstract":[{"type":"text","text":"Which rows participate in the summary."}],"navigatorTitle":[{"text":"GHSummaryScope","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/gingham\/ghsummaryscope","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSummaryScope","type":"topic","title":"GHSummaryScope","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GHSummaryScope","kind":"identifier"}],"role":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/synchronousSummaryLimit":{"title":"synchronousSummaryLimit","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"synchronousSummaryLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Up to this many values to read (data source rows × summarized columns),"},{"type":"text","text":" "},{"type":"text","text":"summaries are computed right away. Above it, "},{"type":"codeVoice","code":"reloadData()"},{"type":"text","text":" shows the"},{"type":"text","text":" "},{"type":"text","text":"rows at once and the summary row follows when it has been computed in"},{"type":"text","text":" "},{"type":"text","text":"the background, keeping the app responsive with large data."}],"url":"\/documentation\/gingham\/ghtableview\/synchronoussummarylimit","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/synchronousSummaryLimit","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/reloadData()":{"abstract":[{"text":"Reads the data again: the number of rows, the visible cells, the","type":"text"},{"text":" ","type":"text"},{"text":"summaries, the filter and the search index.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/gingham\/ghtableview\/reloaddata()","role":"symbol","title":"reloadData()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reloadData","kind":"identifier"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadData()"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/showsSummaryRow":{"type":"topic","abstract":[{"type":"text","text":"Whether the summary row shows at the bottom of the table (while there"},{"type":"text","text":" "},{"type":"text","text":"is data, see "},{"type":"codeVoice","code":"emptyStateText"},{"type":"text","text":")."}],"kind":"symbol","url":"\/documentation\/gingham\/ghtableview\/showssummaryrow","role":"symbol","title":"showsSummaryRow","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"showsSummaryRow","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/showsSummaryRow"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/reloadSummary()":{"title":"reloadSummary()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reloadSummary"},{"kind":"text","text":"()"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Recomputes the summary row without reloading cells."}],"url":"\/documentation\/gingham\/ghtableview\/reloadsummary()","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/reloadSummary()","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/isComputingSummary":{"abstract":[{"type":"text","text":"Whether summaries are being computed in the background; the summary row"},{"type":"text","text":" "},{"type":"text","text":"shows the previous values meanwhile."}],"type":"topic","kind":"symbol","url":"\/documentation\/gingham\/ghtableview\/iscomputingsummary","role":"symbol","title":"isComputingSummary","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isComputingSummary"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isComputingSummary"},"doc://ngtable.Gingham/documentation/Gingham/GroupingRows":{"abstract":[{"type":"text","text":"Gather rows under collapsible header rows with subtotals."}],"type":"topic","kind":"article","url":"\/documentation\/gingham\/groupingrows","role":"collectionGroup","title":"Grouping Rows","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GroupingRows"},"doc://ngtable.Gingham/documentation/Gingham":{"title":"Gingham","type":"topic","role":"collection","abstract":[{"type":"text","text":"A fast table for business data on the Mac, iPad and iPhone: frozen columns,"},{"type":"text","text":" "},{"type":"text","text":"column groups, a summary row with formulas, row grouping with subtotals, search and filters, stable"},{"type":"text","text":" "},{"text":"selection across reloads, and live updates.","type":"text"}],"url":"\/documentation\/gingham","kind":"symbol","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham"},"doc://ngtable.Gingham/documentation/Gingham/IntegratingIntoAnApp":{"title":"Integrating into an App","type":"topic","role":"article","abstract":[{"text":"A complete setup for records loaded from a server: columns, data source,","type":"text"},{"text":" ","type":"text"},{"text":"identity, sorting, search, filters, summaries, menus and refreshing.","type":"text"}],"url":"\/documentation\/gingham\/integratingintoanapp","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/IntegratingIntoAnApp","kind":"article"},"doc://ngtable.Gingham/documentation/Gingham/GHValueFilter":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GHValueFilter","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"GHValueFilter","kind":"identifier"}],"url":"\/documentation\/gingham\/ghvaluefilter","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Which values an aggregate takes into account. Empty and non-numeric values"},{"type":"text","text":" "},{"type":"text","text":"are always left out."}],"title":"GHValueFilter","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHValueFilter"},"doc://ngtable.Gingham/documentation/Gingham/GHTableViewDelegate/tableViewDidUpdateSummary(_:)":{"title":"tableViewDidUpdateSummary(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tableViewDidUpdateSummary"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"GHTableView","preciseIdentifier":"c:@M@Gingham@objc(cs)GHTableView"},{"kind":"text","text":")"}],"type":"topic","role":"symbol","required":true,"abstract":[{"type":"text","text":"Called when summaries computed in the background (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"GHTableView.synchronousSummaryLimit"},{"type":"text","text":") are ready and shown."}],"defaultImplementations":1,"url":"\/documentation\/gingham\/ghtableviewdelegate\/tableviewdidupdatesummary(_:)","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableViewDidUpdateSummary(_:)","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/summaryValue(forColumnID:)":{"abstract":[{"type":"text","text":"The current summary value of a column (an aggregate or a formula) in the"},{"type":"text","text":" "},{"type":"text","text":"current "},{"type":"codeVoice","code":"summaryScope"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{