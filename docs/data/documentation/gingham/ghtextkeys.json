{"seeAlsoSections":[{"anchor":"Selection-Sorting-and-Actions","identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/SelectionAndSorting","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/MenusAndActions","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/EditingCells","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSorting","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCollationKeyProvider","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCollationKeyMaker"],"generated":true,"title":"Selection, Sorting and Actions"}],"topicSections":[{"identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys\/init()"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys\/makeKeyMaker(collatorIdentifier:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys"},"metadata":{"symbolKind":"struct","title":"GHTextKeys","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"GHTextKeys"}],"modules":[{"name":"Gingham"}],"externalID":"s:7Gingham10GHTextKeysV","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHTextKeys"}]},"abstract":[{"text":"Collation keys made by Gingham itself, without ICU: the table’s text sorts","type":"text"},{"text":" ","type":"text"},{"text":"use them unless an app sets another provider (or none) in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/collationKeyProvider","isActive":true,"type":"reference"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"GHTextKeys"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/PerformanceAndThreading"]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A key is each character’s place in the collator’s order at the primary","type":"text"},{"text":" ","type":"text"},{"text":"strength (letters, not case or accents: the table orders those rows by","type":"text"},{"text":" ","type":"text"},{"text":"comparing them), with runs of ASCII digits by their value, so the keys","type":"text"},{"text":" ","type":"text"},{"text":"order text like ","type":"text"},{"code":"localizedStandardCompare","type":"codeVoice"},{"text":". The places are learned from","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Foundation’s own comparison for the collator (once, about 30 ms), for the"},{"text":" ","type":"text"},{"type":"text","text":"characters of the Latin, Greek and Cyrillic scripts, spaces, punctuation,"},{"text":" ","type":"text"},{"text":"currency signs and full-width forms: a language’s own letters (Swedish","type":"text"},{"text":" ","type":"text"},{"text":"å after z, Russian putting Cyrillic first) come with it, and the letters","type":"text"},{"text":" ","type":"text"},{"text":"it joins into one (Czech “ch” after “h”, Danish “aa” as “å”, Hungarian","type":"text"},{"text":" ","type":"text"},{"text":"“dzs”, Welsh “ng” before “n”). Hebrew, Arabic, Devanagari, Thai, kana,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Han and Hangul letters are learned the first time a sort’s texts have"},{"type":"text","text":" "},{"type":"text","text":"them (a sample of them read first; Han in a few tenths of a second)."},{"type":"text","text":" "},{"type":"text","text":"Other characters sort after those by their code point, which may"},{"type":"text","text":" "},{"type":"text","text":"disagree: the table finds any pair out of order and sorts by comparing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before it’s used, a collator’s table sorts thousands of texts by key and"},{"type":"text","text":" "},{"type":"text","text":"checks them against Foundation; a collator its keys can’t follow gets"},{"type":"text","text":" "},{"type":"text","text":"none ("},{"type":"codeVoice","code":"nil"},{"type":"text","text":": the table compares, as without a provider). Then a sort"},{"type":"text","text":" "},{"type":"text","text":"compares the neighbors whose order the keys may not settle (characters"},{"type":"text","text":" "},{"type":"text","text":"Foundation weighs in ways a key can’t, as Han read by the word in"},{"type":"text","text":" "},{"text":"Chinese: “重” in “重庆” as “chóng”), and puts back those out of order.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/gingham\/ghtextkeys"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/ngtable.Gingham\/documentation\/Gingham"]]},"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCollationKeyProvider","doc:\/\/ngtable.Gingham\/s8SendableP","doc:\/\/ngtable.Gingham\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"references":{"doc://ngtable.Gingham/documentation/Gingham/GHCollationKeyProvider":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"GHCollationKeyProvider"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHCollationKeyProvider"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCollationKeyProvider","kind":"symbol","role":"symbol","url":"\/documentation\/gingham\/ghcollationkeyprovider","title":"GHCollationKeyProvider","abstract":[{"text":"Makes collation keys for the table’s text sorts (see","type":"text"},{"text":" ","type":"text"},{"code":"GHTableView.collationKeyProvider","type":"codeVoice"},{"text":").","type":"text"}]},"doc://ngtable.Gingham/documentation/Gingham/GHCollationKeyMaker":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"GHCollationKeyMaker"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHCollationKeyMaker"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCollationKeyMaker","kind":"symbol","role":"symbol","url":"\/documentation\/gingham\/ghcollationkeymaker","title":"GHCollationKeyMaker","abstract":[{"text":"Makes the collation keys of texts on one thread.","type":"text"}]},"doc://ngtable.Gingham/s8SendableP":{"identifier":"doc:\/\/ngtable.Gingham\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://ngtable.Gingham/documentation/Gingham/GHTextKeys":{"role":"symbol","title":"GHTextKeys","url":"\/documentation\/gingham\/ghtextkeys","type":"topic","kind":"symbol","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys","abstract":[{"type":"text","text":"Collation keys made by Gingham itself, without ICU: the table’s text sorts"},{"text":" ","type":"text"},{"text":"use them unless an app sets another provider (or none) in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/collationKeyProvider","type":"reference","isActive":true},{"text":".","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"GHTextKeys"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHTextKeys"}]},"doc://ngtable.Gingham/documentation/Gingham":{"url":"\/documentation\/gingham","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A fast table for business data on the Mac, iPad and iPhone: frozen columns,"},{"type":"text","text":" "},{"type":"text","text":"column groups, a summary row with formulas, row grouping with subtotals, search and filters, stable"},{"type":"text","text":" "},{"text":"selection across reloads, and live updates.","type":"text"}],"title":"Gingham","role":"collection"},"doc://ngtable.Gingham/documentation/Gingham/PerformanceAndThreading":{"role":"article","title":"Performance and Threading","url":"\/documentation\/gingham\/performanceandthreading","type":"topic","kind":"article","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/PerformanceAndThreading","abstract":[{"type":"text","text":"What the table asks for and when, so it stays fast with large data."}]},"doc://ngtable.Gingham/documentation/Gingham/SelectionAndSorting":{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/SelectionAndSorting","url":"\/documentation\/gingham\/selectionandsorting","kind":"article","type":"topic","abstract":[{"text":"Keep the selection on the same records, react to it, and sort when the user","type":"text"},{"text":" ","type":"text"},{"text":"clicks a header.","type":"text"}],"role":"article","title":"Selection and Sorting"},"doc://ngtable.Gingham/documentation/Gingham/GHTextKeys/makeKeyMaker(collatorIdentifier:)":{"role":"symbol","title":"makeKeyMaker(collatorIdentifier:)","url":"\/documentation\/gingham\/ghtextkeys\/makekeymaker(collatoridentifier:)","type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys\/makeKeyMaker(collatorIdentifier:)","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeKeyMaker"},{"kind":"text","text":"("},{"kind":"externalParam","text":"collatorIdentifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") -> ("},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"GHCollationKeyMaker","preciseIdentifier":"s:7Gingham19GHCollationKeyMakerP"},{"kind":"text","text":")?"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/collationKeyProvider":{"role":"symbol","title":"collationKeyProvider","url":"\/documentation\/gingham\/ghtableview\/collationkeyprovider","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Collation keys for sorting text, which sort a million rows in a"},{"type":"text","text":" "},{"type":"text","text":"fraction of the time comparing them takes (see "},{"type":"codeVoice","code":"GHCollationKeyProvider"},{"type":"text","text":"):"},{"type":"text","text":" "},{"type":"text","text":"Gingham’s own ("},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys","isActive":true},{"type":"text","text":", the default:"},{"type":"text","text":" "},{"type":"codeVoice","code":"GHTableView.defaultCollationKeyProvider"},{"type":"text","text":"), or e.g."},{"type":"text","text":" "},{"type":"codeVoice","code":"GHBundledICUCollation()"},{"type":"text","text":" from the optional GinghamICU library (it adds"},{"type":"text","text":" "},{"type":"text","text":"about 9 MB per architecture to the app). The order stays"},{"type":"text","text":" "},{"type":"codeVoice","code":"localizedStandardCompare"},{"type":"text","text":"’s: rows with equal keys are compared, and"},{"type":"text","text":" "},{"type":"text","text":"every pair of neighbors is checked. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" compares text, on all cores."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/collationKeyProvider","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"collationKeyProvider"},{"kind":"text","text":": ("},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"GHCollationKeyProvider","preciseIdentifier":"s:7Gingham22GHCollationKeyProviderP"},{"kind":"text","text":")?"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTextKeys/init()":{"role":"symbol","title":"init()","url":"\/documentation\/gingham\/ghtextkeys\/init()","type":"topic","kind":"symbol","abstract":[],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys\/init()","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}]},"doc://ngtable.Gingham/documentation/Gingham/GHSorting":{"role":"symbol","title":"GHSorting","url":"\/documentation\/gingham\/ghsorting","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Sorting rows by the table’s "},{"type":"codeVoice","code":"NSSortDescriptor"},{"type":"text","text":"s when the data source works"},{"type":"text","text":" "},{"type":"text","text":"with cell values rather than key-value coded objects."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSorting","navigatorTitle":[{"kind":"identifier","text":"GHSorting"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHSorting"}]},"doc://ngtable.Gingham/documentation/Gingham/EditingCells":{"role":"article","title":"Editing Cells","url":"\/documentation\/gingham\/editingcells","type":"topic","kind":"article","abstract":[{"type":"text","text":"Let users move from cell to cell with the keyboard and edit values in place,"},{"type":"text","text":" "},{"type":"text","text":"like a spreadsheet."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/EditingCells"},"doc://ngtable.Gingham/s16SendableMetatypeP":{"identifier":"doc:\/\/ngtable.Gingham\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://ngtable.Gingham/documentation/Gingham/MenusAndActions":{"role":"article","title":"Menus and Actions","url":"\/documentation\/gingham\/menusandactions","type":"topic","kind":"article","abstract":[{"type":"text","text":"Offer your app’s actions in the rows’ context menu, and copy rows to other apps."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/MenusAndActions"}}}