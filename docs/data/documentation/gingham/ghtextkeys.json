{"sections":[],"variants":[{"paths":["\/documentation\/gingham\/ghtextkeys"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Collation keys made by Gingham itself, without ICU: the table’s text sorts"},{"type":"text","text":" "},{"type":"text","text":"use them unless an app sets another provider (or none) in"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/collationKeyProvider","isActive":true},{"type":"text","text":"."}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCollationKeyProvider","doc:\/\/ngtable.Gingham\/s8SendableP","doc:\/\/ngtable.Gingham\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/ngtable.Gingham\/documentation\/Gingham"]]},"topicSections":[{"identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys\/init()"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys\/makeKeyMaker(collatorIdentifier:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GHTextKeys","kind":"identifier"}]}]},{"mentions":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/PerformanceAndThreading"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A key is each character’s place in the collator’s order at the primary"},{"type":"text","text":" "},{"type":"text","text":"strength (letters, not case or accents: the table orders those rows by"},{"type":"text","text":" "},{"type":"text","text":"comparing them), with runs of ASCII digits by their value, so the keys"},{"type":"text","text":" "},{"type":"text","text":"order text like "},{"type":"codeVoice","code":"localizedStandardCompare"},{"type":"text","text":". The places are learned from"},{"type":"text","text":" "},{"type":"text","text":"Foundation’s own comparison for the collator (once, about 30 ms), for the"},{"type":"text","text":" "},{"type":"text","text":"characters of the Latin, Greek and Cyrillic scripts, spaces, punctuation,"},{"type":"text","text":" "},{"type":"text","text":"currency signs and full-width forms: a language’s own letters (Swedish"},{"type":"text","text":" "},{"type":"text","text":"å after z, Russian putting Cyrillic first) come with it, and the letters"},{"type":"text","text":" "},{"type":"text","text":"it joins into one (Czech “ch” after “h”, Danish “aa” as “å”, Hungarian"},{"type":"text","text":" "},{"type":"text","text":"“dzs”, Welsh “ng” before “n”). Hebrew, Arabic, Devanagari, Thai, kana,"},{"type":"text","text":" "},{"type":"text","text":"Han and Hangul letters are learned the first time a sort’s texts have"},{"type":"text","text":" "},{"type":"text","text":"them (a sample of them read first; Han in a few tenths of a second)."},{"type":"text","text":" "},{"type":"text","text":"Other characters sort after those by their code point, which may"},{"type":"text","text":" "},{"type":"text","text":"disagree: the table finds any pair out of order and sorts by comparing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before it’s used, a collator’s table sorts thousands of texts by key and"},{"type":"text","text":" "},{"type":"text","text":"checks them against Foundation; a collator its keys can’t follow gets"},{"type":"text","text":" "},{"type":"text","text":"none ("},{"type":"codeVoice","code":"nil"},{"type":"text","text":": the table compares, as without a provider). Then a sort"},{"type":"text","text":" "},{"type":"text","text":"compares the neighbors whose order the keys may not settle (characters"},{"type":"text","text":" "},{"type":"text","text":"Foundation weighs in ways a key can’t, as Han read by the word in"},{"type":"text","text":" "},{"type":"text","text":"Chinese: “重” in “重庆” as “chóng”), and puts back those out of order."}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHTextKeys"}],"modules":[{"name":"Gingham"}],"navigatorTitle":[{"text":"GHTextKeys","kind":"identifier"}],"externalID":"s:7Gingham10GHTextKeysV","roleHeading":"Structure","title":"GHTextKeys"},"identifier":{"url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/SelectionAndSorting","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/MenusAndActions","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/EditingCells","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSorting","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCollationKeyProvider","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCollationKeyMaker"],"anchor":"Selection-Sorting-and-Actions","generated":true,"title":"Selection, Sorting and Actions"}],"kind":"symbol","references":{"doc://ngtable.Gingham/documentation/Gingham/GHSorting":{"navigatorTitle":[{"kind":"identifier","text":"GHSorting"}],"abstract":[{"type":"text","text":"Sorting rows by the table’s "},{"type":"codeVoice","code":"NSSortDescriptor"},{"type":"text","text":"s when the data source works"},{"type":"text","text":" "},{"type":"text","text":"with cell values rather than key-value coded objects."}],"kind":"symbol","url":"\/documentation\/gingham\/ghsorting","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHSorting"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSorting","role":"symbol","title":"GHSorting","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/collationKeyProvider":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/collationKeyProvider","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"collationKeyProvider"},{"kind":"text","text":": ("},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Gingham22GHCollationKeyProviderP","text":"GHCollationKeyProvider"},{"kind":"text","text":")?"}],"role":"symbol","kind":"symbol","url":"\/documentation\/gingham\/ghtableview\/collationkeyprovider","title":"collationKeyProvider","abstract":[{"type":"text","text":"Collation keys for sorting text, which sort a million rows in a"},{"type":"text","text":" "},{"type":"text","text":"fraction of the time comparing them takes (see "},{"type":"codeVoice","code":"GHCollationKeyProvider"},{"type":"text","text":"):"},{"type":"text","text":" "},{"type":"text","text":"Gingham’s own ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys"},{"type":"text","text":", the default:"},{"type":"text","text":" "},{"type":"codeVoice","code":"GHTableView.defaultCollationKeyProvider"},{"type":"text","text":"), or e.g."},{"type":"text","text":" "},{"type":"codeVoice","code":"GHBundledICUCollation()"},{"type":"text","text":" from the optional GinghamICU library (it adds"},{"type":"text","text":" "},{"type":"text","text":"about 9 MB per architecture to the app). The order stays"},{"type":"text","text":" "},{"type":"codeVoice","code":"localizedStandardCompare"},{"type":"text","text":"’s: rows with equal keys are compared, and"},{"type":"text","text":" "},{"type":"text","text":"every pair of neighbors is checked. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" compares text, on all cores."}]},"doc://ngtable.Gingham/documentation/Gingham/GHTextKeys":{"type