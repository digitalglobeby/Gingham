{"abstract":[{"type":"text","text":"Let users move from cell to cell with the keyboard and edit values in place,"},{"type":"text","text":" "},{"text":"like a spreadsheet.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Two independent options:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/navigatesByCell","type":"reference","isActive":true},{"type":"text","text":" gives the table a focused cell"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/focusedCell","isActive":true},{"type":"text","text":"): Left and Right move it from column to"},{"type":"text","text":" "},{"type":"text","text":"column, Tab and Shift-Tab too, Up and Down from row to row (selecting the"},{"type":"text","text":" "},{"type":"text","text":"row), and a click focuses the cell clicked. A ring shows it once the keys"},{"type":"text","text":" "},{"type":"text","text":"move it; a click, Escape or the table losing the focus hide the ring."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Columns that are ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableColumn\/isEditable","isActive":true,"type":"reference"},{"text":" edit in place.","type":"text"}]}]}]},{"code":["GHTableColumn(\"name\", title: \"Name\", isEditable: true)","GHTableColumn(\"budget\", title: \"Budget\", format: .currency(code: \"USD\"), isEditable: true)","","table.navigatesByCell = true"],"syntax":"swift","type":"codeListing"},{"anchor":"Ranges-of-cells","text":"Ranges of cells","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"With navigation by cell, Shift with the arrow keys, a Shift-click or a drag"},{"type":"text","text":" "},{"type":"text","text":"selects a rectangle of cells from the focused cell"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/selectedCellRange"},{"type":"text","text":", an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCellRange"},{"type":"text","text":" of two corner cells)."},{"type":"text","text":" "},{"type":"text","text":"Its rows are the selected rows, so the summary row’s “selected rows” scope"},{"type":"text","text":" "},{"type":"text","text":"covers them; Copy copies the range’s cells (or just the focused cell) as"},{"type":"text","text":" "},{"type":"text","text":"tab-separated text, which pastes into Numbers and Excel as cells; Escape"},{"type":"text","text":" "},{"type":"text","text":"drops the range. The corners are data source rows and column ids, so after a"},{"type":"text","text":" "},{"type":"text","text":"sort the range spans the rows between them as shown."}],"type":"paragraph"},{"type":"heading","text":"Editing","anchor":"Editing","level":3},{"inlineContent":[{"type":"text","text":"A double click on an editable cell, Return on the focused cell, or typing on"},{"type":"text","text":" "},{"type":"text","text":"it (the text replaces the value) opens a text field over the cell. Typed keys"},{"type":"text","text":" "},{"type":"text","text":"go to the field itself, so input methods (Japanese, Chinese, accents held"},{"type":"text","text":" "},{"type":"text","text":"down) compose there as in any text field; the selection keeps its focused"},{"type":"text","text":" "},{"type":"text","text":"look while the cell is edited. Return"},{"type":"text","text":" "},{"type":"text","text":"commits and moves down, Tab commits and moves on, Escape cancels; clicking"},{"type":"text","text":" "},{"type":"text","text":"elsewhere commits. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/editCell(row:columnID:text:)"},{"type":"text","text":" starts"},{"type":"text","text":" "},{"type":"text","text":"editing from code, and so does"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/editColumn(_:row:with:select:)"},{"type":"text","text":", as with "},{"type":"codeVoice","code":"NSTableView"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/editedRow"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/editedColumn"},{"type":"text","text":" tell which cell is"},{"type":"text","text":" "},{"type":"text","text":"being edited (-1 when none; the row follows its record as rows move), and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/abortEditing()"},{"type":"text","text":" throws the text away, e.g. before the app"},{"type":"text","text":" "},{"type":"text","text":"replaces the data."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The text is read by the column’s format: numbers in the user’s locale or with"},{"type":"text","text":" "},{"type":"text","text":"English separators (currency symbols aside, “25%” as 0.25 in percent"},{"type":"text","text":" "},{"type":"text","text":"columns), dates for date columns, text otherwise; an empty field is "},{"type":"codeVoice","code":".empty"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Text that isn’t a number where one is due changes nothing."}],"type":"paragraph"},{"inlineContent":[{"text":"The data source receives the value, like ","type":"text"},{"code":"NSTableView","type":"codeVoice"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"tableView(_:setObjectValue:for:row:)"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["func tableView(_ tableView: GHTableView, setValue value: GHCellValue, for column: GHTableColumn, row: Int) {","    switch (column.id, value) {","    case (\"name\", .text(let name)): campaigns[row].name = name","    case (\"budget\", .number(let budget)): campaigns[row].budget = budget","    default: break","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The table then reads the row again (its summaries, filter, sort and groups","type":"text"},{"type":"text","text":" "},{"text":"follow), and registers the change with the window’s undo manager: Undo sets","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the old value back through the same method. The delegate’s"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:shouldEdit:row:)"},{"type":"text","text":" can keep a cell from"},{"type":"text","text":" "},{"type":"text","text":"being edited."}],"type":"paragraph"},{"anchor":"Check-boxes-and-lists","text":"Check boxes and lists","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Boolean cells of an editable column show a check box. A click on the box"},{"type":"text","text":" "},{"type":"text","text":"toggles it (and selects the row), as do Space on the focused cell, Return and"},{"type":"text","text":" "},{"type":"text","text":"a double click. A column with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableColumn\/editChoices"},{"type":"text","text":" edits in a menu"},{"type":"text","text":" "},{"type":"text","text":"of those values instead of a text field: Return or a double click opens it"},{"type":"text","text":" "},{"type":"text","text":"under the cell, with the current value checked (typing doesn’t). Both reach"},{"type":"text","text":" "},{"type":"text","text":"the data source and Undo the same way as text:"}],"type":"paragraph"},{"code":["GHTableColumn(\"autoBid\", title: \"Auto bid\", alignment: .center, isEditable: true)","GHTableColumn(\"status\", title: \"Status\", isEditable: true, editChoices: [","    .tags([GHTag(\"Active\", color: .green)]),","    .tags([GHTag(\"Paused\", color: .gray)]),","])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Menu items show the values as the column displays them, tags with their"},{"type":"text","text":" "},{"type":"text","text":"color."}],"type":"paragraph"},{"anchor":"Ratings","text":"Ratings","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"An editable column of "},{"type":"codeVoice","code":".rating"},{"type":"text","text":" values is edited without a field: a click on"},{"type":"text","text":" "},{"type":"text","text":"a star sets it, just before the first one clears it, and a number key sets"},{"type":"text","text":" "},{"type":"text","text":"the focused cell (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/DisplayingValues"},{"type":"text","text":")."}],"type":"paragraph"},{"anchor":"Choices-that-open-on-a-click","text":"Choices that open on a click","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Every cell of an editable column with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableColumn\/editChoices"},{"type":"text","text":" shows a"},{"type":"text","text":" "},{"type":"text","text":"pop-up button’s up-down chevron at its trailing edge, so it reads as a menu"},{"type":"text","text":" "},{"type":"text","text":"before it’s clicked. Set "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableColumn\/opensChoicesOnClick"},{"type":"text","text":" to open the"},{"type":"text","text":" "},{"type":"text","text":"menu on a single click (selecting the row too), like an "},{"type":"codeVoice","code":"NSPopUpButton"},{"type":"text","text":" in a"},{"type":"text","text":" "},{"type":"text","text":"cell; otherwise it opens on a double click or Return."}],"type":"paragraph"}]}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gingham\/editingcells"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/EditingCells"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/ngtable.Gingham\/documentation\/Gingham"]]},"seeAlsoSections":[{"generated":true,"anchor":"Selection-Sorting-and-Actions","title":"Selection, Sorting and Actions","identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/SelectionAndSorting","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/MenusAndActions","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSorting","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTextKeys","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCollationKeyProvider","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCollationKeyMaker"]}],"metadata":{"role":"article","title":"Editing Cells","modules":[{"name":"Gingham"}],"roleHeading":"Article"},"references":{"doc://ngtable.Gingham/documentation/Gingham/GHCellRange":{"type":"topic","abstract":[{"type":"text","text":"A rectangle of cells between two corners (see "},{"type":"codeVoice","code":"GHTableView.selectedCellRange"},{"type":"text","text":")."}],"kind":"symbol","url":"\/documentation\/gingham\/ghcellrange","role":"symbol","navigatorTitle":[{"text":"GHCellRange","kind":"identifier"}],"title":"GHCellRange","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GHCellRange","kind":"identifier"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHCellRange"},"doc://ngtable.Gingha