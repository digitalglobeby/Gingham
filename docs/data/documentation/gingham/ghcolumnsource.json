"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">, ","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GHTextBatch","kind":"typeIdentifier","preciseIdentifier":"s:7Gingham11GHTextBatchV"},{"text":")","kind":"text"}],"defaultImplementations":1},"doc://ngtable.Gingham/documentation/Gingham/ReleaseNotes":{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/ReleaseNotes","type":"topic","role":"article","abstract":[{"type":"text","text":"What each version of Gingham brought."}],"url":"\/documentation\/gingham\/releasenotes","kind":"article","title":"Release Notes"}}}