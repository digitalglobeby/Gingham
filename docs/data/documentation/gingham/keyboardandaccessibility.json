{"sections":[],"hierarchy":{"paths":[["doc:\/\/ngtable.Gingham\/documentation\/Gingham"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"The table becomes the first responder when clicked, and Tab and Shift-Tab","type":"text"},{"text":" ","type":"text"},{"text":"move the focus on to the next and previous controls of the window.","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Keys"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Up Arrow, Down Arrow"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Select the previous or next row"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift-Up Arrow, Shift-Down Arrow"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Extend the selection"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Left Arrow, Right Arrow"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Scroll the scrolling columns by one column"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Page Up, Page Down"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Scroll by a page"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Home, End"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Scroll to the first or last row"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Command-A"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Select all rows shown"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Command-C"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Copy the selected rows (see "},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/MenusAndActions","isActive":true,"type":"reference"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Typing letters"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Select the next row whose value starts with them"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Space"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Passed on to your app (e.g. for Quick Look), unless it continues a type select search"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Tab, Shift-Tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move the focus to the next or previous control"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"With ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/navigatesByCell","isActive":true,"type":"reference"},{"text":", the keys move a focused cell instead:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Keys"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Arrow keys"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move the focused cell (right to left, Left goes on)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift-arrow keys"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Extend a range of cells ("},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/selectedCellRange","isActive":true,"type":"reference"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Tab, Shift-Tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The next or previous cell"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Return"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Edit the focused cell when it’s editable (then Return and Tab commit, Escape cancels)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Space"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Toggle the focused check box"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Typing"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Start editing the focused cell with what’s typed"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Command-C"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Copy the range of cells, or the focused cell"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Escape"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Clear the range of cells (the focused cell’s row stays selected); with no range, hide the focus ring; then pass Escape on"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"Command-A and Command-C come through the Edit menu: include Copy and Select All","type":"text"},{"text":" ","type":"text"},{"text":"in your main menu.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"With ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/rowGrouping","isActive":true,"type":"reference"},{"text":", Up Arrow and Down Arrow stop on group","type":"text"},{"text":" ","type":"text"},{"text":"header rows too, like in ","type":"text"},{"code":"NSOutlineView","type":"codeVoice"},{"text":". A header the keyboard is on is drawn","type":"text"},{"text":" ","type":"text"},{"text":"selected, but it isn’t part of the selection: no rows are selected while the","type":"text"},{"text":" ","type":"text"},{"text":"keyboard is there. On a header:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Left Arrow"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Collapse the group, or go to the group it’s in when collapsed"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Right Arrow"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Expand the group, or go to its first row when expanded"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Option-Left Arrow, Option-Right Arrow"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The same, with every group within it"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"Shift with the arrows extends the selection over rows only. Users also","type":"text"},{"text":" ","type":"text"},{"text":"collapse and expand groups by clicking the headers or from their context menu","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GroupingRows","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Keys the table doesn’t use go on to the next responder, like in other AppKit","type":"text"},{"text":" ","type":"text"},{"text":"views: handle them in your view controller. A space goes on too, unless it is","type":"text"},{"text":" ","type":"text"},{"text":"part of a type select search (“summer sale”), so a Quick Look panel can open on","type":"text"},{"text":" ","type":"text"},{"text":"the space bar:","type":"text"}],"type":"paragraph"},{"code":["override func keyDown(with event: NSEvent) {","    if event.charactersIgnoringModifiers == \" \" {","        toggleQuickLook()","    } else {","        super.keyDown(with: event)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"While the table updates its data (see ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isUpdatingData","isActive":true,"type":"reference"},{"text":"), it","type":"text"},{"text":" ","type":"text"},{"text":"passes on every key, so shortcuts such as Escape to cancel loading still work.","type":"text"}],"type":"paragraph"},{"text":"Type select","level":3,"type":"heading","anchor":"Type-select"},{"inlineContent":[{"text":"Typing the beginning of a value selects the first matching row from the","type":"text"},{"text":" ","type":"text"},{"text":"current one on, like in Finder. Letters typed in quick succession continue","type":"text"},{"text":" ","type":"text"},{"text":"the search; after a pause, typing starts a new search, and typing the same","type":"text"},{"text":" ","type":"text"},{"text":"letter again moves on to the next match. The table searches","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/typeSelectColumnID","isActive":true,"type":"reference"},{"text":", or the first shown column when it is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"ignoring case and diacritics.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The delegate can change that, as with NSTableView:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:shouldTypeSelectFor:withCurrentSearch:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"lets a key go on to the next responder (a shortcut of your own), and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:nextTypeSelectMatchFromRow:toRow:for:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"finds the match itself, e.g. anywhere in the text. Its rows are display","type":"text"},{"text":" ","type":"text"},{"text":"indexes, the order shown.","type":"text"}],"type":"paragraph"},{"text":"VoiceOver","level":3,"type":"heading","anchor":"VoiceOver"},{"inlineContent":[{"text":"The table presents itself as a table: VoiceOver reads the column headers, the","type":"text"},{"text":" ","type":"text"},{"text":"rows and their cells with the values as displayed (mark labels for marks),","type":"text"},{"text":" ","type":"text"},{"text":"and the summary row. Users can select rows with VoiceOver, and the table","type":"text"},{"text":" ","type":"text"},{"text":"announces changes in the selection and the number of rows. Group header","type":"text"},{"text":" ","type":"text"},{"text":"rows are disclosure rows, like an outline view’s: VoiceOver reads their level","type":"text"},{"text":" ","type":"text"},{"text":"and whether they’re expanded, and can expand and collapse them. Media cells","type":"text"},{"text":" ","type":"text"},{"text":"are read as their lines of text.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Like an NSTableView’s, the table also lists its columns (each with its","type":"text"},{"text":" ","type":"text"},{"text":"header and its cells), the selected cells when navigating by cell, and the","type":"text"},{"text":" ","type":"text"},{"text":"sort direction of sorted columns. A row’s swipe actions are actions of the","type":"text"},{"text":" ","type":"text"},{"text":"row in VoiceOver’s actions menu (VO-Command-Space), and VoiceOver’s “show","type":"text"},{"text":" ","type":"text"},{"text":"menu” (VO-Shift-M) opens the row’s context menu.","type":"text"}],"type":"paragraph"}]}],"metadata":{"title":"Keyboard and Accessibility","modules":[{"name":"Gingham"}],"roleHeading":"Article","role":"article"},"abstract":[{"text":"Use the table without a mouse, and with VoiceOver.","type":"text"}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/KeyboardAndAccessibility"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/gingham\/keyboardandaccessibility"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{