{"abstract":[{"type":"text","text":"Use the table without a mouse, and with VoiceOver."}],"metadata":{"modules":[{"name":"Gingham"}],"roleHeading":"Article","title":"Keyboard and Accessibility","role":"article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/KeyboardAndAccessibility","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Appearance","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSelectionHighlightStyle","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableStyle","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableDensity"],"generated":true,"anchor":"Appearance-and-Behavior","title":"Appearance and Behavior"}],"hierarchy":{"paths":[["doc:\/\/ngtable.Gingham\/documentation\/Gingham"]]},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The table becomes the first responder when clicked, and Tab and Shift-Tab"},{"type":"text","text":" "},{"type":"text","text":"move the focus on to the next and previous controls of the window."}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Keys","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up Arrow, Down Arrow","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Select the previous or next row","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift-Up Arrow, Shift-Down Arrow","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Extend the selection","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Left Arrow, Right Arrow","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Scroll the scrolling columns by one column","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Page Up, Page Down","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Scroll by a page","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Home, End","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Scroll to the first or last row","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Command-A","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Select all rows shown","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Command-C","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Copy the selected rows (see ","type":"text"},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/MenusAndActions","isActive":true},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Typing letters","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Select the next row whose value starts with them","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Space","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Passed on to your app (e.g. for Quick Look), unless it continues a type select search","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tab, Shift-Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move the focus to the next or previous control","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/navigatesByCell","isActive":true},{"type":"text","text":", the keys move a focused cell instead:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Keys","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow keys","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move the focused cell (right to left, Left goes on)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift-arrow keys","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Extend a range of cells (","type":"text"},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/selectedCellRange","isActive":true},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tab, Shift-Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The next or previous cell","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Return","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Edit the focused cell when it’s editable (then Return and Tab commit, Escape cancels)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Space","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Toggle the focused check box","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Typing","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Start editing the focused cell with what’s typed","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Command-C","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Copy the range of cells, or the focused cell","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Escape","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Clear the range of cells (the focused cell’s row stays selected); with no range, hide the focus ring; then pass Escape on","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Command-A and Command-C come through the Edit menu: include Copy and Select All"},{"type":"text","text":" "},{"type":"text","text":"in your main menu."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/rowGrouping","isActive":true},{"type":"text","text":", Up Arrow and Down Arrow stop on group"},{"type":"text","text":" "},{"type":"text","text":"header rows too, like in "},{"type":"codeVoice","code":"NSOutlineView"},{"type":"text","text":". A header the keyboard is on is drawn"},{"type":"text","text":" "},{"type":"text","text":"selected, but it isn’t part of the selection: no rows are selected while the"},{"type":"text","text":" "},{"type":"text","text":"keyboard is there. On a header:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Left Arrow","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Collapse the group, or go to the group it’s in when collapsed","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Right Arrow","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Expand the group, or go to its first row when expanded","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Option-Left Arrow, Option-Right Arrow","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The same, with every group within it","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift with the arrows extends the selection over rows only. Users also"},{"type":"text","text":" "},{"type":"text","text":"collapse and expand groups by clicking the headers or from their context menu"},{"type":"text","text":" "},{"type":"text","text":"(see "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GroupingRows","isActive":true},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys the table doesn’t use go on to the next responder, like in other AppKit"},{"type":"text","text":" "},{"type":"text","text":"views: handle them in your view controller. A space goes on too, unless it is"},{"type":"text","text":" "},{"type":"text","text":"part of a type select search (“summer sale”), so a Quick Look panel can open on"},{"type":"text","text":" "},{"type":"text","text":"the space bar:"}]},{"type":"codeListing","syntax":"swift","code":["override func keyDown(with event: NSEvent) {","    if event.charactersIgnoringModifiers == \" \" {","        toggleQuickLook()","    } else {","        super.keyDown(with: event)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While the table updates its data (see "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isUpdatingData","isActive":true},{"type":"text","text":"), it"},{"type":"text","text":" "},{"type":"text","text":"passes on every key, so shortcuts such as Escape to cancel loading still work."}]},{"type":"heading","level":3,"anchor":"Type-select","text":"Type select"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Typing the beginning of a value selects the first matching row from the"},{"type":"text","text":" "},{"type":"text","text":"current one on, like in Finder. Letters typed in quick succession continue"},{"type":"text","text":" "},{"type":"text","text":"the search; after a pause, typing starts a new search, and typing the same"},{"type":"text","text":" "},{"type":"text","text":"letter again moves on to the next match. The table searches"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/typeSelectColumnID","isActive":true},{"type":"text","text":", or the first shown column when it is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"ignoring case and diacritics."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The delegate can change that, as with NSTableView:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:shouldTypeSelectFor:withCurrentSearch:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"lets a key go on to the next responder (a shortcut of your own), and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:nextTypeSelectMatchFromRow:toRow:for:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"finds the match itself, e.g. anywhere in the text. Its rows are display"},{"type":"text","text":" "},{"type":"text","text":"indexes, the order shown."}]},{"type":"heading","level":3,"anchor":"VoiceOver","text":"VoiceOver"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The table presents itself as a table: VoiceOver reads the column headers, the"},{"type":"text","text":" "},{"type":"text","text":"rows and their cells with the values as displayed (mark labels for marks),"},{"type":"text","text":" "},{"type":"text","text":"and the summary row. Users can select rows with VoiceOver, and the table"},{"type":"text","text":" "},{"type":"text","text":"announces changes in the selection and the number of rows. Group header"},{"type":"text","text":" "},{"type":"text","text":"rows are disclosure rows, like an outline view’s: VoiceOver reads their level"},{"type":"text","text":" "},{"type":"text","text":"and whether they’re expanded, and can expand and collapse them. Media cells"},{"type":"text","text":" "},{"type":"text","text":"are read as their lines of text."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like an NSTableView’s, the table also lists its columns (each with its"},{"type":"text","text":" "},{"type":"text","text":"header and its cells), the selected cells when navigating by cell, and the"},{"type":"text","text":" "},{"type":"text","text":"sort direction of sorted columns. A row’s swipe actions are actions of the"},{"type":"text","text":" "},{"type":"text","text":"row in VoiceOver’s actions menu (VO-Command-Space), and VoiceOver’s “show"},{"type":"text","text":" "},{"type":"text","text":"menu” (VO-Shift-M) opens the row’s context menu."}]}],"kind":"content"}],"kind":"article","variants":[{"paths":["\/documentation\/gingham\/keyboardandaccessibility"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://ngtable.Gingham/documentation/Gingham/GHSelectionHighlightStyle":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSelectionHighlightStyle","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"GHSelectionHighlightStyle"}],"navigatorTitle":[{"text":"GHSelectionHighlightStyle","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/gingham\/ghselectionhighlightstyle","title":"GHSelectionHighlightStyle","abstract":[{"text":"How selected rows are highlighted.","type":"text"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/rowGrouping":{"kind":"symbol","abstract":[{"type":"text","text":"Groups the rows by the values of some columns, under header rows with"},{"type":"text","text":" "},{"type":"text","text":"subtotals that the user collapses and expands (see "},{"type":"codeVoice","code":"GHRowGrouping"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" shows the rows as they come. Header rows are display rows"},{"text":" ","type":"text"},{"text":"(they count in ","type":"text"},{"code":"numberOfRows","type":"codeVoice"},{"type":"text","text":") but not data source rows: they’re never"},{"text":" ","type":"text"},{"type":"text","text":"selected, and "},{"type":"codeVoice","code":"row(at:)"},{"type":"text","text":" gives -1 for them (see "},{"type":"codeVoice","code":"group(at:)"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Setting another grouping keeps the selected rows that stay shown and"},{"text":" ","type":"text"},{"type":"text","text":"forgets which groups were collapsed; setting the one it is changes"},{"type":"text","text":" "},{"type":"text","text":"nothing (its groups stay collapsed or expanded)."}],"url":"\/documentation\/gingham\/ghtableview\/rowgrouping","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rowGrouping"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GHRowGrouping","preciseIdentifier":"s:7Gingham13GHRowGroupingV"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/rowGrouping","role":"symbol","title":"rowGrouping","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/GHTableViewDelegate/tableView(_:shouldTypeSelectFor:withCurrentSearch:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tableView"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@Gingham@objc(cs)GHTableView","text":"GHTableView"},{"kind":"text","text":", "},{"kind":"externalParam","text":"shouldTypeSelectFor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSEvent","text":"NSEvent"},{"kind":"text","text":", "},{"kind":"externalParam","text":"withCurrentSearch"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:shouldTypeSelectFor:withCurrentSearch:)","defaultImplementations":1,"role":"symbol","abstract":[{"type":"text","text":"Whether a typed key selects rows by type select, like NSTableView’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"tableView(_:shouldTypeSelectFor:withCurrentSearch:)"},{"type":"text","text":": "},{"type":"codeVoice","code":"false"},{"type":"text","text":" lets the"},{"type":"text","text":" "},{"type":"text","text":"key go on to the next responder. "},{"type":"codeVoice","code":"searchString"},{"type":"text","text":" is the search typed"},{"type":"text","text":" "},{"type":"text","text":"so far, "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" before one began."}],"url":"\/documentation\/gingham\/ghtableviewdelegate\/tableview(_:shouldtypeselectfor:withcurrentsearch:)","kind":"symbol","title":"tableView(_:shouldTypeSelectFor:withCurrentSearch:)","type":"topic","required":true},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/typeSelectColumnID":{"abstract":[{"type":"text","text":"The column searched when the user types the beginning of a value, like"},{"type":"text","text":" "},{"type":"text","text":"Finder’s type select. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" uses the first displayed column."}],"role":"symbol","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/typeSelectColumnID","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"typeSelectColumnID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"url":"\/documentation\/gingham\/ghtableview\/typeselectcolumnid","title":"typeSelectColumnID","kind":"symbol","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/MenusAndActions":{"kind":"article","url":"\/documentation\/gingham\/menusandactions","abstract":[{"type":"text","text":"Offer your app’s actions in the rows’ context menu, and copy rows to other apps."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/MenusAndActions","role":"article","title":"Menus and Actions","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/Appearance":{"title":"Appearance","role":"article","url":"\/documentation\/gingham\/appearance","kind":"article","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Appearance","abstract":[{"type":"text","text":"Adjust sizes, highlight rows by their data, and choose how selection and"},{"type":"text","text":" "},{"type":"text","text":"scrolling look."}],"type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/GHTableViewDelegate/tableView(_:nextTypeSelectMatchFromRow:toRow:for:)":{"abstract":[{"type":"text","text":"The first row in "},{"type":"codeVoice","code":"startRow..<endRow"},{"type":"text","text":" matching what was typed, or -1,"},{"type":"text","text":" "},{"type":"text","text":"like NSTableView’s "},{"type":"codeVoice","code":"tableView(_:nextTypeSelectMatchFromRow:toRow:for:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Rows here are display indexes (see "},{"type":"codeVoice","code":"GHTableView.row(atDisplayIndex:)"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"the order shown when the table sorts, filters or groups. A search that"},{"type":"text","text":" "},{"type":"text","text":"wraps asks for the rows after the current one, then from the top,"},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"codeVoice","code":"endRow"},{"type":"text","text":" is never less than "},{"type":"codeVoice","code":"startRow"},{"type":"text","text":". By default the table’s own"},{"type":"text","text":" "},{"type":"text","text":"match: the text of the type select column starting with the string."}],"defaultImplementations":1,"required":true,"role":"symbol","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:nextTypeSelectMatchFromRow:toRow:for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tableView"},{"kind":"text","text":"("},{"preciseIdentifier":"c:@M@Gingham@objc(cs)GHTableView","kind":"typeIdentifier","text":"GHTableView"},{"kind":"text","text":", "},{"kind":"externalParam","text":"nextTypeSelectMatchFromRow"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"toRow"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"url":"\/documentation\/gingham\/ghtableviewdelegate\/tableview(_:nexttypeselectmatchfromrow:torow:for:)","title":"tableView(_:nextTypeSelectMatchFromRow:toRow:for:)","kind":"symbol","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/isUpdatingData":{"role":"symbol","abstract":[{"type":"text","text":"Whether the app is updating the table’s data, e.g. loading another"},{"type":"text","text":" "},{"type":"text","text":"period or refreshing from a server. The table then fades and ignores the"},{"type":"text","text":" "},{"type":"text","text":"user (clicks, scrolling, menus, the keyboard), so nobody acts on rows that"},{"type":"text","text":" "},{"type":"text","text":"are about to change; reloading it from code works as usual. The fade"},{"type":"text","text":" "},{"type":"text","text":"starts after a moment, so updates that finish at once don’t flash."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUpdatingData"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","title":"isUpdatingData","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isUpdatingData","url":"\/documentation\/gingham\/ghtableview\/isupdatingdata","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/selectedCellRange":{"abstract":[{"type":"text","text":"A rectangle of cells the user selected with navigation by cell"},{"type":"text","text":" "},{"type":"text","text":"(Shift with arrows, a Shift-click, a drag), or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"; its rows are"},{"type":"text","text":" "},{"type":"text","text":"the selected rows, and Copy copies its cells (see GHCellSelection.swift)."},{"type":"text","text":" "},{"type":"text","text":"Its corners are kept by row handle, like "},{"type":"codeVoice","code":"focusedCell"},{"type":"text","text":"."}],"url":"\/documentation\/gingham\/ghtableview\/selectedcellrange","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"selectedCellRange"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GHCellRange","preciseIdentifier":"s:7Gingham11GHCellRangeV"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/selectedCellRange","role":"symbol","title":"selectedCellRange","type":"topic"},"doc://ngtable.Gingham/documentation/Gingham/GHTableStyle":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableStyle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHTableStyle"}],"navigatorTitle":[{"text":"GHTableStyle","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/gingham\/ghtablestyle","title":"GHTableStyle","abstract":[{"text":"Fonts and colors of a table; ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" keeps the system default.","type":"text"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/navigatesByCell":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"navigatesByCell"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Whether the keyboard moves a focused cell (","type":"text"},{"code":"focusedCell","type":"codeVoice"},{"text":") instead of","type":"text"},{"text":" ","type":"text"},{"text":"whole rows: Left and Right go from column to column, Tab and Shift-Tab","type":"text"},{"text":" ","type":"text"},{"text":"too, Up and Down from row to row; a click focuses the cell clicked.","type":"text"},{"text":" ","type":"text"},{"text":"Editable cells edit on Return, a double click or typing.","type":"text"}],"url":"\/documentation\/gingham\/ghtableview\/navigatesbycell","role":"symbol","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/navigatesByCell","type":"topic","title":"navigatesByCell","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GroupingRows":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GroupingRows","role":"collectionGroup","kind":"article","url":"\/documentation\/gingham\/groupingrows","title":"Grouping Rows","abstract":[{"type":"text","text":"Gather rows under collapsible header rows with subtotals."}]},"doc://ngtable.Gingham/documentation/Gingham":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham","role":"collection","kind":"symbol","url":"\/documentation\/gingham","title":"Gingham","abstract":[{"type":"text","text":"A fast table for business data on the Mac, iPad and iPhone: frozen columns,"},{"type":"text","text":" "},{"type":"text","text":"column groups, a summary row with formulas, row grouping with subtotals, search and filters, stable"},{"type":"text","text":" "},{"type":"text","text":"selection across reloads, and live updates."}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableDensity":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableDensity","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHTableDensity"}],"navigatorTitle":[{"kind":"identifier","text":"GHTableDensity"}],"role":"symbol","kind":"symbol","url":"\/documentation\/gingham\/ghtabledensity","title":"GHTableDensity","abstract":[{"text":"How much room rows give their text, like Finder’s and Mail’s list sizes.","type":"text"}]}}}