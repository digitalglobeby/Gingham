nd":"text"},{"text":"rowGrouping","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GHRowGrouping","preciseIdentifier":"s:7Gingham13GHRowGroupingV"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableViewDelegate/tableView(_:nextTypeSelectMatchFromRow:toRow:for:)":{"abstract":[{"text":"The first row in ","type":"text"},{"type":"codeVoice","code":"startRow..<endRow"},{"text":" matching what was typed, or -1,","type":"text"},{"type":"text","text":" "},{"text":"like NSTableView’s ","type":"text"},{"type":"codeVoice","code":"tableView(_:nextTypeSelectMatchFromRow:toRow:for:)"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Rows here are display indexes (see "},{"code":"GHTableView.row(atDisplayIndex:)","type":"codeVoice"},{"type":"text","text":"),"},{"text":" ","type":"text"},{"text":"the order shown when the table sorts, filters or groups. A search that","type":"text"},{"text":" ","type":"text"},{"text":"wraps asks for the rows after the current one, then from the top,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"so "},{"code":"endRow","type":"codeVoice"},{"type":"text","text":" is never less than "},{"code":"startRow","type":"codeVoice"},{"text":". By default the table’s own","type":"text"},{"type":"text","text":" "},{"type":"text","text":"match: the text of the type select column starting with the string."}],"kind":"symbol","defaultImplementations":1,"url":"\/documentation\/gingham\/ghtableviewdelegate\/tableview(_:nexttypeselectmatchfromrow:torow:for:)","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:nextTypeSelectMatchFromRow:toRow:for:)","type":"topic","title":"tableView(_:nextTypeSelectMatchFromRow:toRow:for:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tableView"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"GHTable