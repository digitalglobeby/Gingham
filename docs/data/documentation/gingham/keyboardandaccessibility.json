ntifier","text":"isUpdatingData"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/gingham\/ghtableview\/isupdatingdata","title":"isUpdatingData","kind":"symbol","abstract":[{"type":"text","text":"Whether the app is updating the table’s data, e.g. loading another"},{"type":"text","text":" "},{"type":"text","text":"period or refreshing from a server. The table then fades and ignores the"},{"type":"text","text":" "},{"type":"text","text":"user (clicks, scrolling, menus, the keyboard), so nobody acts on rows that"},{"type":"text","text":" "},{"type":"text","text":"are about to change; reloading it from code works as usual. The fade"},{"type":"text","text":" "},{"type":"text","text":"starts after a moment, so updates that finish at once don’t flash."}],"role":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/typeSelectColumnID":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"typeSelectColumnID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/gingham\/ghtableview\/typeselectcolumnid","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The column searched when the user types the beginning of a value, like"},{"type":"text","text":" "},{"type":"text","text":"Finder’s type select. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" uses the first displayed column."}],"title":"typeSelectColumnID","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/typeSelectColumnID"},"doc://ngtable.Gingham/documentation/Gingham/MenusAndActions":{"abstract":[{"type":"text","text":"Offer your app’s actions in the rows’ context menu, and copy rows to other apps."}],"kind":"article","url":"\/documentation\/gingham\/menusandactions","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/MenusAndActions","type":"topic","title":"Menus and Actions","role":"article"}}}