{"kind":"article","variants":[{"paths":["\/documentation\/gingham\/keyboardandaccessibility"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/ngtable.Gingham\/documentation\/Gingham"]]},"abstract":[{"text":"Use the table without a mouse, and with VoiceOver.","type":"text"}],"metadata":{"modules":[{"name":"Gingham"}],"roleHeading":"Article","role":"article","title":"Keyboard and Accessibility"},"identifier":{"url":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/KeyboardAndAccessibility","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"The table becomes the first responder when clicked, and Tab and Shift-Tab","type":"text"},{"text":" ","type":"text"},{"text":"move the focus on to the next and previous controls of the window.","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Keys","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Up Arrow, Down Arrow","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Select the previous or next row","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Shift-Up Arrow, Shift-Down Arrow","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Extend the selection","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Left Arrow, Right Arrow","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Scroll the scrolling columns by one column","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Page Up, Page Down","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Scroll by a page","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Home, End","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Scroll to the first or last row","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Command-A","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Select all rows shown","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Command-C","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Copy the selected rows (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/MenusAndActions","type":"reference"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Typing letters","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Select the next row whose value starts with them","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Space","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Passed on to your app (e.g. for Quick Look), unless it continues a type select search","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Tab, Shift-Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move the focus to the next or previous control","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"With "},{"type":"reference","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/navigatesByCell","isActive":true},{"type":"text","text":", the keys move a focused cell instead:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Keys","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Arrow keys","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move the focused cell (right to left, Left goes on)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Shift-arrow keys","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Extend a range of cells (","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/selectedCellRange","type":"reference"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Tab, Shift-Tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The next or previous cell","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Return"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Edit the focused cell when it’s editable (then Return and Tab commit, Escape cancels)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Space"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Toggle the focused check box"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Typing"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Start editing the focused cell with what’s typed"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Command-C"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Copy the range of cells, or the focused cell"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Escape"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Clear the range of cells (the focused cell’s row stays selected); with no range, hide the focus ring; then pass Escape on"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Command-A and Command-C come through the Edit menu: include Copy and Select All","type":"text"},{"text":" ","type":"text"},{"text":"in your main menu.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"With ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/rowGrouping","type":"reference"},{"text":", Up Arrow and Down Arrow stop on group","type":"text"},{"text":" ","type":"text"},{"text":"header rows too, like in ","type":"text"},{"code":"NSOutlineView","type":"codeVoice"},{"text":". A header the keyboard is on is drawn","type":"text"},{"text":" ","type":"text"},{"text":"selected, but it isn’t part of the selection: no rows are selected while the","type":"text"},{"text":" ","type":"text"},{"text":"keyboard is there. On a header:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Left Arrow"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Collapse the group, or go to the group it’s in when collapsed"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Right Arrow"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Expand the group, or go to its first row when expanded"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Option-Left Arrow, Option-Right Arrow"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The same, with every group within it"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Shift with the arrows extends the selection over rows only. Users also","type":"text"},{"text":" ","type":"text"},{"text":"collapse and expand groups by clicking the headers or from their context menu","type":"text"},{"text":" ","type":"text"},{"text":"(see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GroupingRows","type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Keys the table doesn’t use go on to the next responder, like in other AppKit","type":"text"},{"text":" ","type":"text"},{"text":"views: handle them in your view controller. A space goes on too, unless it is","type":"text"},{"text":" ","type":"text"},{"text":"part of a type select search (“summer sale”), so a Quick Look panel can open on","type":"text"},{"text":" ","type":"text"},{"text":"the space bar:","type":"text"}],"type":"paragraph"},{"code":["override func keyDown(with event: NSEvent) {","    if event.charactersIgnoringModifiers == \" \" {","        toggleQuickLook()","    } else {","        super.keyDown(with: event)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"While the table updates its data (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isUpdatingData","type":"reference"},{"text":"), it","type":"text"},{"text":" ","type":"text"},{"text":"passes on every key, so shortcuts such as Escape to cancel loading still work.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Type select","anchor":"Type-select","type":"heading"},{"inlineContent":[{"text":"Typing the beginning of a value selects the first matching row from the","type":"text"},{"text":" ","type":"text"},{"text":"current one on, like in Finder. Letters typed in quick succession continue","type":"text"},{"text":" ","type":"text"},{"text":"the search; after a pause, typing starts a new search, and typing the same","type":"text"},{"text":" ","type":"text"},{"text":"letter again moves on to the next match. The table searches","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/typeSelectColumnID","type":"reference"},{"text":", or the first shown column when it is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"ignoring case and diacritics.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The delegate can change that, as with NSTableView:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:shouldTypeSelectFor:withCurrentSearch:)","type":"reference"},{"text":" ","type":"text"},{"text":"lets a key go on to the next responder (a shortcut of your own), and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:nextTypeSelectMatchFromRow:toRow:for:)","type":"reference"},{"text":" ","type":"text"},{"text":"finds the match itself, e.g. anywhere in the text. Its rows are display","type":"text"},{"text":" ","type":"text"},{"text":"indexes, the order shown.","type":"text"}],"type":"paragraph"},{"level":3,"text":"VoiceOver","anchor":"VoiceOver","type":"heading"},{"inlineContent":[{"text":"The table presents itself as a table: VoiceOver reads the column headers, the","type":"text"},{"text":" ","type":"text"},{"text":"rows and their cells with the values as displayed (mark labels for marks),","type":"text"},{"text":" ","type":"text"},{"text":"and the summary row. Users can select rows with VoiceOver, and the table","type":"text"},{"text":" ","type":"text"},{"text":"announces changes in the selection and the number of rows. Group header","type":"text"},{"text":" ","type":"text"},{"text":"rows are disclosure rows, like an outline view’s: VoiceOver reads their level","type":"text"},{"text":" ","type":"text"},{"text":"and whether they’re expanded, and can expand and collapse them. Media cells","type":"text"},{"text":" ","type":"text"},{"text":"are read as their lines of text.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Like an NSTableView’s, the table also lists its columns (each with its","type":"text"},{"text":" ","type":"text"},{"text":"header and its cells), the selected cells when navigating by cell, and the","type":"text"},{"text":" ","type":"text"},{"text":"sort direction of sorted columns. A row’s swipe actions are actions of the","type":"text"},{"text":" ","type":"text"},{"text":"row in VoiceOver’s actions menu (VO-Command-Space), and VoiceOver’s “show","type":"text"},{"text":" ","type":"text"},{"text":"menu” (VO-Shift-M) opens the row’s context menu.","type":"text"}],"type":"paragraph"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/ngtable.Gingham\/documentation\/Gingham\/Appearance","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSelectionHighlightStyle","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableStyle","doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableDensity"],"title":"Appearance and Behavior","generated":true,"anchor":"Appearance-and-Behavior"}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://ngtable.Gingham/documentation/Gingham/MenusAndActions":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/MenusAndActions","title":"Menus and Actions","kind":"article","role":"article","url":"\/documentation\/gingham\/menusandactions","abstract":[{"type":"text","text":"Offer your app’s actions in the rows’ context menu, and copy rows to other apps."}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableDensity":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GHTableDensity"}],"navigatorTitle":[{"text":"GHTableDensity","kind":"identifier"}],"abstract":[{"text":"How much room rows give their text, like Finder’s and Mail’s list sizes.","type":"text"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableDensity","title":"GHTableDensity","url":"\/documentation\/gingham\/ghtabledensity","type":"topic","role":"symbol","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/navigatesByCell":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"navigatesByCell","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/navigatesByCell","abstract":[{"text":"Whether the keyboard moves a focused cell (","type":"text"},{"type":"codeVoice","code":"focusedCell"},{"text":") instead of","type":"text"},{"text":" ","type":"text"},{"text":"whole rows: Left and Right go from column to column, Tab and Shift-Tab","type":"text"},{"text":" ","type":"text"},{"text":"too, Up and Down from row to row; a click focuses the cell clicked.","type":"text"},{"text":" ","type":"text"},{"text":"Editable cells edit on Return, a double click or typing.","type":"text"}],"url":"\/documentation\/gingham\/ghtableview\/navigatesbycell","title":"navigatesByCell","kind":"symbol","role":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableViewDelegate/tableView(_:nextTypeSelectMatchFromRow:toRow:for:)":{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableViewDelegate\/tableView(_:nextTypeSelectMatchFromRow:toRow:for:)","type":"topic","required":true,"title":"tableView(_:nextTypeSelectMatchFromRow:toRow:for:)","kind":"symbol","role":"symbol","url":"\/documentation\/gingham\/ghtableviewdelegate\/tableview(_:nexttypeselectmatchfromrow:torow:for:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tableView","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:@M@Gingham@objc(cs)GHTableView","kind":"typeIdentifier","text":"GHTableView"},{"kind":"text","text":", "},{"text":"nextTypeSelectMatchFromRow","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"toRow"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"defaultImplementations":1,"abstract":[{"type":"text","text":"The first row in "},{"type":"codeVoice","code":"startRow..<endRow"},{"type":"text","text":" matching what was typed, or -1,"},{"type":"text","text":" "},{"type":"text","text":"like NSTableView’s "},{"type":"codeVoice","code":"tableView(_:nextTypeSelectMatchFromRow:toRow:for:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Rows here are display indexes (see "},{"code":"GHTableView.row(atDisplayIndex:)","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"the order shown when the table sorts, filters or groups. A search that"},{"type":"text","text":" "},{"type":"text","text":"wraps asks for the rows after the current one, then from the top,"},{"type":"text","text":" "},{"type":"text","text":"so "},{"code":"endRow","type":"codeVoice"},{"type":"text","text":" is never less than "},{"code":"startRow","type":"codeVoice"},{"type":"text","text":". By default the table’s own"},{"type":"text","text":" "},{"type":"text","text":"match: the text of the type select column starting with the string."}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/rowGrouping":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rowGrouping"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GHRowGrouping","preciseIdentifier":"s:7Gingham13GHRowGroupingV"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"Groups the rows by the values of some columns, under header rows with"},{"type":"text","text":" "},{"type":"text","text":"subtotals that the user collapses and expands (see "},{"code":"GHRowGrouping","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" shows the rows as they come. Header rows are display rows"},{"type":"text","text":" "},{"type":"text","text":"(they count in "},{"code":"numberOfRows","type":"codeVoice"},{"type":"text","text":") but not data source rows: they’re never"},{"type":"text","text":" "},{"type":"text","text":"selected, and "},{"code":"row(at:)","type":"codeVoice"},{"type":"text","text":" gives -1 for them (see "},{"type":"codeVoice","code":"group(at:)"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Setting another grouping keeps the selected rows that stay shown and"},{"type":"text","text":" "},{"type":"text","text":"forgets which groups were collapsed; setting the one it is changes"},{"type":"text","text":" "},{"type":"text","text":"nothing (its groups stay collapsed or expanded)."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/rowGrouping","title":"rowGrouping","url":"\/documentation\/gingham\/ghtableview\/rowgrouping","type":"topic","role":"symbol","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GroupingRows":{"abstract":[{"type":"text","text":"Gather rows under collapsible header rows with subtotals."}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GroupingRows","title":"Grouping Rows","url":"\/documentation\/gingham\/groupingrows","type":"topic","role":"collectionGroup","kind":"article"},"doc://ngtable.Gingham/documentation/Gingham/GHTableStyle":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GHTableStyle","kind":"identifier"}],"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableStyle","title":"GHTableStyle","abstract":[{"text":"Fonts and colors of a table; ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" keeps the system default.","type":"text"}],"url":"\/documentation\/gingham\/ghtablestyle","type":"topic","navigatorTitle":[{"kind":"identifier","text":"GHTableStyle"}],"kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham":{"abstract":[{"type":"text","text":"A fast table for business data on the Mac, iPad and iPhone: frozen columns,"},{"type":"text","text":" "},{"type":"text","text":"column groups, a summary row with formulas, row grouping with subtotals, search and filters, stable"},{"type":"text","text":" "},{"type":"text","text":"selection across reloads, and live updates."}],"type":"topic","role":"collection","url":"\/documentation\/gingham","kind":"symbol","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham","title":"Gingham"},"doc://ngtable.Gingham/documentation/Gingham/GHSelectionHighlightStyle":{"type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHSelectionHighlightStyle","title":"GHSelectionHighlightStyle","navigatorTitle":[{"kind":"identifier","text":"GHSelectionHighlightStyle"}],"kind":"symbol","role":"symbol","url":"\/documentation\/gingham\/ghselectionhighlightstyle","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GHSelectionHighlightStyle","kind":"identifier"}],"abstract":[{"text":"How selected rows are highlighted.","type":"text"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/isUpdatingData":{"identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isUpdatingData","type":"topic","title":"isUpdatingData","kind":"symbol","role":"symbol","url":"\/documentation\/gingham\/ghtableview\/isupdatingdata","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUpdatingData"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"abstract":[{"text":"Whether the app is updating the table’s data, e.g. loading another","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"period or refreshing from a server. The table then fades and ignores the"},{"type":"text","text":" "},{"type":"text","text":"user (clicks, scrolling, menus, the keyboard), so nobody acts on rows that"},{"type":"text","text":" "},{"text":"are about to change; reloading it from code works as usual. The fade","type":"text"},{"text":" ","type":"text"},{"text":"starts after a moment, so updates that finish at once don’t flash.","type":"text"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/selectedCellRange":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"selectedCellRange","kind":"identifier"