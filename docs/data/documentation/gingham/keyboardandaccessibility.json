when the user types the beginning of a value, like"},{"type":"text","text":" "},{"type":"text","text":"Finder’s type select. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" uses the first displayed column."}],"title":"typeSelectColumnID","type":"topic","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/typeSelectColumnID","kind":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/isUpdatingData":{"url":"\/documentation\/gingham\/ghtableview\/isupdatingdata","abstract":[{"text":"Whether the app is updating the table’s data, e.g. loading another","type":"text"},{"text":" ","type":"text"},{"text":"period or refreshing from a server. The table then fades and ignores the","type":"text"},{"text":" ","type":"text"},{"text":"user (clicks, scrolling, menus, the keyboard), so nobody acts on rows that","type":"text"},{"text":" ","type":"text"},{"text":"are about to change; reloading it from code works as usual. The fade","type":"text"},{"text":" ","type":"text"},{"text":"starts after a moment, so updates that finish at once don’t flash.","type":"text"}],"type":"topic","kind":"symbol","title":"isUpdatingData","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/isUpdatingData","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUpdatingData"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol"},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/navigatesByCell":{"url":"\/documentation\/gingham\/ghtableview\/navigatesbycell","abstract":[{"text":"Whether the keyboard moves a focused cell (","type":"text"},{"code":"focusedCell","type":"codeVoice"},{"text":") instead of","type":"text"},{"text":" ","type":"text"},{"text":"whole rows: Left and Right go from column to column, Tab and Shift-Tab","type":"text"},{"text":" ","type":"text"},{"text":"too, Up and Down from row to row; a click focuses t