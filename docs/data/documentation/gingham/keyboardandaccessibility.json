Rows","type":"codeVoice"},{"text":") but not data source rows: they’re never","type":"text"},{"text":" ","type":"text"},{"text":"selected, and ","type":"text"},{"code":"row(at:)","type":"codeVoice"},{"text":" gives -1 for them (see ","type":"text"},{"code":"group(at:)","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Setting another grouping keeps the selected rows that stay shown and","type":"text"},{"text":" ","type":"text"},{"text":"forgets which groups were collapsed; setting the one it is changes","type":"text"},{"text":" ","type":"text"},{"text":"nothing (its groups stay collapsed or expanded).","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rowGrouping"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Gingham13GHRowGroupingV","text":"GHRowGrouping"},{"kind":"text","text":"?"}]},"doc://ngtable.Gingham/documentation/Gingham/GHTableView/selectedCellRange":{"url":"\/documentation\/gingham\/ghtableview\/selectedcellrange","type":"topic","abstract":[{"text":"A rectangle of cells the user selected with navigation by cell","type":"text"},{"text":" ","type":"text"},{"text":"(Shift with arrows, a Shift-click, a drag), or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":"; its rows are","type":"text"},{"text":" ","type":"text"},{"text":"the selected rows, and Copy copies its cells (see GHCellSelection.swift).","type":"text"},{"type":"text","text":" "},{"text":"Its corners are kept by row handle, like ","type":"text"},{"code":"focusedCell","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","title":"selectedCellRange","identifier":"doc:\/\/ngtable.Gingham\/documentation\/Gingham\/GHTableView\/selectedCellRange","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"selectedCellRange"},{"text":": ","kind":"text"},{"text":"GHCellRange","preciseIdentifier":"s:7Gingham11GHCellRangeV","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"role":"symbol"}}}